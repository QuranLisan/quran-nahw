{"surah":86,"ar":"الطارق","en":"At-Tariq","ayahs":17,"verses":[{"w":["وَالسَّمَآءِ","وَالطَّارِقِ"]},{"w":["وَمَاۤ","اَدْرٰىكَ","مَا","الطَّارِقُ"]},{"w":["النَّجْمُ","الثَّاقِبُ"]},{"w":["اِنْ","كُلُّ","نَفْسٍ","لَّمَّا","عَلَیْهَا","حَافِظٌ"]},{"w":["فَلْیَنْظُرِ","الْاِنْسَانُ","مِمَّ","خُلِقَ"]},{"w":["خُلِقَ","مِنْ","مَّآءٍ","دَافِقٍ"]},{"w":["یَّخْرُجُ","مِنْ","بَیْنِ","الصُّلْبِ","وَالتَّرَآىِٕبِ"]},{"w":["اِنَّهٗ","عَلٰی","رَجْعِهٖ","لَقَادِرٌ"]},{"w":["یَوْمَ","تُبْلَی","السَّرَآىِٕرُ"]},{"w":["فَمَا","لَهٗ","مِنْ","قُوَّةٍ","وَّلَا","نَاصِرٍ"]},{"w":["وَالسَّمَآءِ","ذَاتِ","الرَّجْعِ"]},{"w":["وَالْاَرْضِ","ذَاتِ","الصَّدْعِ"]},{"w":["اِنَّهٗ","لَقَوْلٌ","فَصْلٌ"]},{"w":["وَّمَا","هُوَ","بِالْهَزْلِ"]},{"w":["اِنَّهُمْ","یَكِیْدُوْنَ","كَیْدًا"]},{"w":["وَّاَكِیْدُ","كَیْدًا"]},{"w":["فَمَهِّلِ","الْكٰفِرِیْنَ","اَمْهِلْهُمْ","رُوَیْدًا"]}]}