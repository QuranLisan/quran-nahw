{"surah":15,"ar":"الحجر","en":"Al-Hijr","ayahs":99,"verses":[{"w":["الٓرٰ","تِلْكَ","اٰیٰتُ","الْكِتٰبِ","وَقُرْاٰنٍ","مُّبِیْنٍ"]},{"w":["رُبَمَا","یَوَدُّ","الَّذِیْنَ","كَفَرُوْا","لَوْ","كَانُوْا","مُسْلِمِیْنَ"]},{"w":["ذَرْهُمْ","یَاْكُلُوْا","وَیَتَمَتَّعُوْا","وَیُلْهِهِمُ","الْاَمَلُ","فَسَوْفَ","یَعْلَمُوْنَ"]},{"w":["وَمَاۤ","اَهْلَكْنَا","مِنْ","قَرْیَةٍ","اِلَّا","وَلَهَا","كِتَابٌ","مَّعْلُوْمٌ"]},{"w":["مَا","تَسْبِقُ","مِنْ","اُمَّةٍ","اَجَلَهَا","وَمَا","یَسْتَاْخِرُوْنَ"]},{"w":["وَقَالُوْا","یٰۤاَیُّهَا","الَّذِیْ","نُزِّلَ","عَلَیْهِ","الذِّكْرُ","اِنَّكَ","لَمَجْنُوْنٌ"]},{"w":["لَوْ","مَا","تَاْتِیْنَا","بِالْمَلٰٓىِٕكَةِ","اِنْ","كُنْتَ","مِنَ","الصّٰدِقِیْنَ"]},{"w":["مَا","نُنَزِّلُ","الْمَلٰٓىِٕكَةَ","اِلَّا","بِالْحَقِّ","وَمَا","كَانُوْۤا","اِذًا","مُّنْظَرِیْنَ"]},{"w":["اِنَّا","نَحْنُ","نَزَّلْنَا","الذِّكْرَ","وَاِنَّا","لَهٗ","لَحٰفِظُوْنَ"]},{"w":["وَلَقَدْ","اَرْسَلْنَا","مِنْ","قَبْلِكَ","فِیْ","شِیَعِ","الْاَوَّلِیْنَ"]},{"w":["وَمَا","یَاْتِیْهِمْ","مِّنْ","رَّسُوْلٍ","اِلَّا","كَانُوْا","بِهٖ","یَسْتَهْزِءُوْنَ"]},{"w":["كَذٰلِكَ","نَسْلُكُهٗ","فِیْ","قُلُوْبِ","الْمُجْرِمِیْنَ"]},{"w":["لَا","یُؤْمِنُوْنَ","بِهٖ","وَقَدْ","خَلَتْ","سُنَّةُ","الْاَوَّلِیْنَ"]},{"w":["وَلَوْ","فَتَحْنَا","عَلَیْهِمْ","بَابًا","مِّنَ","السَّمَآءِ","فَظَلُّوْا","فِیْهِ","یَعْرُجُوْنَ"]},{"w":["لَقَالُوْۤا","اِنَّمَا","سُكِّرَتْ","اَبْصَارُنَا","بَلْ","نَحْنُ","قَوْمٌ","مَّسْحُوْرُوْنَ"]},{"w":["وَلَقَدْ","جَعَلْنَا","فِی","السَّمَآءِ","بُرُوْجًا","وَّزَیَّنّٰهَا","لِلنّٰظِرِیْنَ"]},{"w":["وَحَفِظْنٰهَا","مِنْ","كُلِّ","شَیْطٰنٍ","رَّجِیْمٍ"]},{"w":["اِلَّا","مَنِ","اسْتَرَقَ","السَّمْعَ","فَاَتْبَعَهٗ","شِهَابٌ","مُّبِیْنٌ"]},{"w":["وَالْاَرْضَ","مَدَدْنٰهَا","وَاَلْقَیْنَا","فِیْهَا","رَوَاسِیَ","وَاَنْۢبَتْنَا","فِیْهَا","مِنْ","كُلِّ","شَیْءٍ","مَّوْزُوْنٍ"]},{"w":["وَجَعَلْنَا","لَكُمْ","فِیْهَا","مَعَایِشَ","وَمَنْ","لَّسْتُمْ","لَهٗ","بِرٰزِقِیْنَ"]},{"w":["وَاِنْ","مِّنْ","شَیْءٍ","اِلَّا","عِنْدَنَا","خَزَآىِٕنُهٗ ؗ","وَمَا","نُنَزِّلُهٗۤ","اِلَّا","بِقَدَرٍ","مَّعْلُوْمٍ"]},{"w":["وَاَرْسَلْنَا","الرِّیٰحَ","لَوَاقِحَ","فَاَنْزَلْنَا","مِنَ","السَّمَآءِ","مَآءً","فَاَسْقَیْنٰكُمُوْهُ","وَمَاۤ","اَنْتُمْ","لَهٗ","بِخٰزِنِیْنَ"]},{"w":["وَاِنَّا","لَنَحْنُ","نُحْیٖ","وَنُمِیْتُ","وَنَحْنُ","الْوٰرِثُوْنَ"]},{"w":["وَلَقَدْ","عَلِمْنَا","الْمُسْتَقْدِمِیْنَ","مِنْكُمْ","وَلَقَدْ","عَلِمْنَا","الْمُسْتَاْخِرِیْنَ"]},{"w":["وَاِنَّ","رَبَّكَ","هُوَ","یَحْشُرُهُمْ ؕ","اِنَّهٗ","حَكِیْمٌ","عَلِیْمٌ"]},{"w":["وَلَقَدْ","خَلَقْنَا","الْاِنْسَانَ","مِنْ","صَلْصَالٍ","مِّنْ","حَمَاٍ","مَّسْنُوْنٍ"]},{"w":["وَالْجَآنَّ","خَلَقْنٰهُ","مِنْ","قَبْلُ","مِنْ","نَّارِ","السَّمُوْمِ"]},{"w":["وَاِذْ","قَالَ","رَبُّكَ","لِلْمَلٰٓىِٕكَةِ","اِنِّیْ","خَالِقٌۢ","بَشَرًا","مِّنْ","صَلْصَالٍ","مِّنْ","حَمَاٍ","مَّسْنُوْنٍ"]},{"w":["فَاِذَا","سَوَّیْتُهٗ","وَنَفَخْتُ","فِیْهِ","مِنْ","رُّوْحِیْ","فَقَعُوْا","لَهٗ","سٰجِدِیْنَ"]},{"w":["فَسَجَدَ","الْمَلٰٓىِٕكَةُ","كُلُّهُمْ","اَجْمَعُوْنَ"]},{"w":["اِلَّاۤ","اِبْلِیْسَ ؕ","اَبٰۤی","اَنْ","یَّكُوْنَ","مَعَ","السّٰجِدِیْنَ"]},{"w":["قَالَ","یٰۤاِبْلِیْسُ","مَا","لَكَ","اَلَّا","تَكُوْنَ","مَعَ","السّٰجِدِیْنَ"]},{"w":["قَالَ","لَمْ","اَكُنْ","لِّاَسْجُدَ","لِبَشَرٍ","خَلَقْتَهٗ","مِنْ","صَلْصَالٍ","مِّنْ","حَمَاٍ","مَّسْنُوْنٍ"]},{"w":["قَالَ","فَاخْرُجْ","مِنْهَا","فَاِنَّكَ","رَجِیْمٌ"]},{"w":["وَّاِنَّ","عَلَیْكَ","اللَّعْنَةَ","اِلٰی","یَوْمِ","الدِّیْنِ"]},{"w":["قَالَ","رَبِّ","فَاَنْظِرْنِیْۤ","اِلٰی","یَوْمِ","یُبْعَثُوْنَ"]},{"w":["قَالَ","فَاِنَّكَ","مِنَ","الْمُنْظَرِیْنَ"]},{"w":["اِلٰی","یَوْمِ","الْوَقْتِ","الْمَعْلُوْمِ"]},{"w":["قَالَ","رَبِّ","بِمَاۤ","اَغْوَیْتَنِیْ","لَاُزَیِّنَنَّ","لَهُمْ","فِی","الْاَرْضِ","وَلَاُغْوِیَنَّهُمْ","اَجْمَعِیْنَ"]},{"w":["اِلَّا","عِبَادَكَ","مِنْهُمُ","الْمُخْلَصِیْنَ"]},{"w":["قَالَ","هٰذَا","صِرَاطٌ","عَلَیَّ","مُسْتَقِیْمٌ"]},{"w":["اِنَّ","عِبَادِیْ","لَیْسَ","لَكَ","عَلَیْهِمْ","سُلْطٰنٌ","اِلَّا","مَنِ","اتَّبَعَكَ","مِنَ","الْغٰوِیْنَ"]},{"w":["وَاِنَّ","جَهَنَّمَ","لَمَوْعِدُهُمْ","اَجْمَعِیْنَ"]},{"w":["لَهَا","سَبْعَةُ","اَبْوَابٍ ؕ","لِكُلِّ","بَابٍ","مِّنْهُمْ","جُزْءٌ","مَّقْسُوْمٌ"]},{"w":["اِنَّ","الْمُتَّقِیْنَ","فِیْ","جَنّٰتٍ","وَّعُیُوْنٍ"]},{"w":["اُدْخُلُوْهَا","بِسَلٰمٍ","اٰمِنِیْنَ"]},{"w":["وَنَزَعْنَا","مَا","فِیْ","صُدُوْرِهِمْ","مِّنْ","غِلٍّ","اِخْوَانًا","عَلٰی","سُرُرٍ","مُّتَقٰبِلِیْنَ"]},{"w":["لَا","یَمَسُّهُمْ","فِیْهَا","نَصَبٌ","وَّمَا","هُمْ","مِّنْهَا","بِمُخْرَجِیْنَ"]},{"w":["نَبِّئْ","عِبَادِیْۤ","اَنِّیْۤ","اَنَا","الْغَفُوْرُ","الرَّحِیْمُ"]},{"w":["وَاَنَّ","عَذَابِیْ","هُوَ","الْعَذَابُ","الْاَلِیْمُ"]},{"w":["وَنَبِّئْهُمْ","عَنْ","ضَیْفِ","اِبْرٰهِیْمَ"]},{"w":["اِذْ","دَخَلُوْا","عَلَیْهِ","فَقَالُوْا","سَلٰمًا ؕ","قَالَ","اِنَّا","مِنْكُمْ","وَجِلُوْنَ"]},{"w":["قَالُوْا","لَا","تَوْجَلْ","اِنَّا","نُبَشِّرُكَ","بِغُلٰمٍ","عَلِیْمٍ"]},{"w":["قَالَ","اَبَشَّرْتُمُوْنِیْ","عَلٰۤی","اَنْ","مَّسَّنِیَ","الْكِبَرُ","فَبِمَ","تُبَشِّرُوْنَ"]},{"w":["قَالُوْا","بَشَّرْنٰكَ","بِالْحَقِّ","فَلَا","تَكُنْ","مِّنَ","الْقٰنِطِیْنَ"]},{"w":["قَالَ","وَمَنْ","یَّقْنَطُ","مِنْ","رَّحْمَةِ","رَبِّهٖۤ","اِلَّا","الضَّآلُّوْنَ"]},{"w":["قَالَ","فَمَا","خَطْبُكُمْ","اَیُّهَا","الْمُرْسَلُوْنَ"]},{"w":["قَالُوْۤا","اِنَّاۤ","اُرْسِلْنَاۤ","اِلٰی","قَوْمٍ","مُّجْرِمِیْنَ"]},{"w":["اِلَّاۤ","اٰلَ","لُوْطٍ ؕ","اِنَّا","لَمُنَجُّوْهُمْ","اَجْمَعِیْنَ"]},{"w":["اِلَّا","امْرَاَتَهٗ","قَدَّرْنَاۤ","اِنَّهَا","لَمِنَ","الْغٰبِرِیْنَ"]},{"w":["فَلَمَّا","جَآءَ","اٰلَ","لُوْطِ","لْمُرْسَلُوْنَ"]},{"w":["قَالَ","اِنَّكُمْ","قَوْمٌ","مُّنْكَرُوْنَ"]},{"w":["قَالُوْا","بَلْ","جِئْنٰكَ","بِمَا","كَانُوْا","فِیْهِ","یَمْتَرُوْنَ"]},{"w":["وَاَتَیْنٰكَ","بِالْحَقِّ","وَاِنَّا","لَصٰدِقُوْنَ"]},{"w":["فَاَسْرِ","بِاَهْلِكَ","بِقِطْعٍ","مِّنَ","الَّیْلِ","وَاتَّبِعْ","اَدْبَارَهُمْ","وَلَا","یَلْتَفِتْ","مِنْكُمْ","اَحَدٌ","وَّامْضُوْا","حَیْثُ","تُؤْمَرُوْنَ"]},{"w":["وَقَضَیْنَاۤ","اِلَیْهِ","ذٰلِكَ","الْاَمْرَ","اَنَّ","دَابِرَ","هٰۤؤُلَآءِ","مَقْطُوْعٌ","مُّصْبِحِیْنَ"]},{"w":["وَجَآءَ","اَهْلُ","الْمَدِیْنَةِ","یَسْتَبْشِرُوْنَ"]},{"w":["قَالَ","اِنَّ","هٰۤؤُلَآءِ","ضَیْفِیْ","فَلَا","تَفْضَحُوْنِ"]},{"w":["وَاتَّقُوا","اللّٰهَ","وَلَا","تُخْزُوْنِ"]},{"w":["قَالُوْۤا","اَوَلَمْ","نَنْهَكَ","عَنِ","الْعٰلَمِیْنَ"]},{"w":["قَالَ","هٰۤؤُلَآءِ","بَنٰتِیْۤ","اِنْ","كُنْتُمْ","فٰعِلِیْنَ"]},{"w":["لَعَمْرُكَ","اِنَّهُمْ","لَفِیْ","سَكْرَتِهِمْ","یَعْمَهُوْنَ"]},{"w":["فَاَخَذَتْهُمُ","الصَّیْحَةُ","مُشْرِقِیْنَ"]},{"w":["فَجَعَلْنَا","عَالِیَهَا","سَافِلَهَا","وَاَمْطَرْنَا","عَلَیْهِمْ","حِجَارَةً","مِّنْ","سِجِّیْلٍ"]},{"w":["اِنَّ","فِیْ","ذٰلِكَ","لَاٰیٰتٍ","لِّلْمُتَوَسِّمِیْنَ"]},{"w":["وَاِنَّهَا","لَبِسَبِیْلٍ","مُّقِیْمٍ"]},{"w":["اِنَّ","فِیْ","ذٰلِكَ","لَاٰیَةً","لِّلْمُؤْمِنِیْنَ"]},{"w":["وَاِنْ","كَانَ","اَصْحٰبُ","الْاَیْكَةِ","لَظٰلِمِیْنَ"]},{"w":["فَانْتَقَمْنَا","مِنْهُمْ ","وَاِنَّهُمَا","لَبِاِمَامٍ","مُّبِیْنٍ"]},{"w":["وَلَقَدْ","كَذَّبَ","اَصْحٰبُ","الْحِجْرِ","الْمُرْسَلِیْنَ"]},{"w":["وَاٰتَیْنٰهُمْ","اٰیٰتِنَا","فَكَانُوْا","عَنْهَا","مُعْرِضِیْنَ"]},{"w":["وَكَانُوْا","یَنْحِتُوْنَ","مِنَ","الْجِبَالِ","بُیُوْتًا","اٰمِنِیْنَ"]},{"w":["فَاَخَذَتْهُمُ","الصَّیْحَةُ","مُصْبِحِیْنَ"]},{"w":["فَمَاۤ","اَغْنٰی","عَنْهُمْ","مَّا","كَانُوْا","یَكْسِبُوْنَ"]},{"w":["وَمَا","خَلَقْنَا","السَّمٰوٰتِ","وَالْاَرْضَ","وَمَا","بَیْنَهُمَاۤ","اِلَّا","بِالْحَقِّ ؕ","وَاِنَّ","السَّاعَةَ","لَاٰتِیَةٌ","فَاصْفَحِ","الصَّفْحَ","الْجَمِیْلَ"]},{"w":["اِنَّ","رَبَّكَ","هُوَ","الْخَلّٰقُ","الْعَلِیْمُ"]},{"w":["وَلَقَدْ","اٰتَیْنٰكَ","سَبْعًا","مِّنَ","الْمَثَانِیْ","وَالْقُرْاٰنَ","الْعَظِیْمَ"]},{"w":["لَا","تَمُدَّنَّ","عَیْنَیْكَ","اِلٰی","مَا","مَتَّعْنَا","بِهٖۤ","اَزْوَاجًا","مِّنْهُمْ","وَلَا","تَحْزَنْ","عَلَیْهِمْ","وَاخْفِضْ","جَنَاحَكَ","لِلْمُؤْمِنِیْنَ"]},{"w":["وَقُلْ","اِنِّیْۤ","اَنَا","النَّذِیْرُ","الْمُبِیْنُ"]},{"w":["كَمَاۤ","اَنْزَلْنَا","عَلَی","الْمُقْتَسِمِیْنَ"]},{"w":["الَّذِیْنَ","جَعَلُوا","الْقُرْاٰنَ","عِضِیْنَ"]},{"w":["فَوَرَبِّكَ","لَنَسْـَٔلَنَّهُمْ","اَجْمَعِیْنَ"]},{"w":["عَمَّا","كَانُوْا","یَعْمَلُوْنَ"]},{"w":["فَاصْدَعْ","بِمَا","تُؤْمَرُ","وَاَعْرِضْ","عَنِ","الْمُشْر