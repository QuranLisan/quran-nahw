{"surah":1,"ar":"الفاتحة","en":"Al-Fatihah","ayahs":7,"verses":[{"w":["بِسْمِ","اللّٰهِ","الرَّحْمٰنِ","الرَّحِیْمِ"]},{"w":["اَلْحَمْدُ","لِلّٰهِ","رَبِّ","الْعٰلَمِیْنَ"]},{"w":["الرَّحْمٰنِ","الرَّحِیْمِ"]},{"w":["مٰلِكِ","یَوْمِ","الدِّیْنِ"]},{"w":["اِیَّاكَ","نَعْبُدُ","وَاِیَّاكَ","نَسْتَعِیْنُ"]},{"w":["اِهْدِنَا","الصِّرَاطَ","الْمُسْتَقِیْمَ"]},{"w":["صِرَاطَ","الَّذِیْنَ","اَنْعَمْتَ","عَلَیْهِمْ ۦ","غَیْرِ","الْمَغْضُوْبِ","عَلَیْهِمْ","وَلَا","الضَّآلِّیْنَ"]}]}