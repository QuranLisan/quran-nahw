{"surah":50,"ar":"ق","en":"Qaf","ayahs":45,"verses":[{"w":["قٓ","وَالْقُرْاٰنِ","الْمَجِیْدِ"]},{"w":["بَلْ","عَجِبُوْۤا","اَنْ","جَآءَهُمْ","مُّنْذِرٌ","مِّنْهُمْ","فَقَالَ","الْكٰفِرُوْنَ","هٰذَا","شَیْءٌ","عَجِیْبٌ"]},{"w":["ءَاِذَا","مِتْنَا","وَكُنَّا","تُرَابًا","ذٰلِكَ","رَجْعٌ","بَعِیْدٌ"]},{"w":["قَدْ","عَلِمْنَا","مَا","تَنْقُصُ","الْاَرْضُ","مِنْهُمْ","وَعِنْدَنَا","كِتٰبٌ","حَفِیْظٌ"]},{"w":["بَلْ","كَذَّبُوْا","بِالْحَقِّ","لَمَّا","جَآءَهُمْ","فَهُمْ","فِیْۤ","اَمْرٍ","مَّرِیْجٍ"]},{"w":["اَفَلَمْ","یَنْظُرُوْۤا","اِلَی","السَّمَآءِ","فَوْقَهُمْ","كَیْفَ","بَنَیْنٰهَا","وَزَیَّنّٰهَا","وَمَا","لَهَا","مِنْ","فُرُوْجٍ"]},{"w":["وَالْاَرْضَ","مَدَدْنٰهَا","وَاَلْقَیْنَا","فِیْهَا","رَوَاسِیَ","وَاَنْۢبَتْنَا","فِیْهَا","مِنْ","كُلِّ","زَوْجٍ","بَهِیْجٍ"]},{"w":["تَبْصِرَةً","وَّذِكْرٰی","لِكُلِّ","عَبْدٍ","مُّنِیْبٍ"]},{"w":["وَنَزَّلْنَا","مِنَ","السَّمَآءِ","مَآءً","مُّبٰرَكًا","فَاَنْۢبَتْنَا","بِهٖ","جَنّٰتٍ","وَّحَبَّ","الْحَصِیْدِ"]},{"w":["وَالنَّخْلَ","بٰسِقٰتٍ","لَّهَا","طَلْعٌ","نَّضِیْدٌ"]},{"w":["رِّزْقًا","لِّلْعِبَادِ","وَاَحْیَیْنَا","بِهٖ","بَلْدَةً","مَّیْتًا ؕ","كَذٰلِكَ","الْخُرُوْجُ"]},{"w":["كَذَّبَتْ","قَبْلَهُمْ","قَوْمُ","نُوْحٍ","وَّاَصْحٰبُ","الرَّسِّ","وَثَمُوْدُ"]},{"w":["وَعَادٌ","وَّفِرْعَوْنُ","وَاِخْوَانُ","لُوْطٍ"]},{"w":["وَّاَصْحٰبُ","الْاَیْكَةِ","وَقَوْمُ","تُبَّعٍ ؕ","كُلٌّ","كَذَّبَ","الرُّسُلَ","فَحَقَّ","وَعِیْدِ"]},{"w":["اَفَعَیِیْنَا","بِالْخَلْقِ","الْاَوَّلِ ؕ","بَلْ","هُمْ","فِیْ","لَبْسٍ","مِّنْ","خَلْقٍ","جَدِیْدٍ"]},{"w":["وَلَقَدْ","خَلَقْنَا","الْاِنْسَانَ","وَنَعْلَمُ","مَا","تُوَسْوِسُ","بِهٖ","نَفْسُهٗ","وَنَحْنُ","اَقْرَبُ","اِلَیْهِ","مِنْ","حَبْلِ","الْوَرِیْدِ"]},{"w":["اِذْ","یَتَلَقَّی","الْمُتَلَقِّیٰنِ","عَنِ","الْیَمِیْنِ","وَعَنِ","الشِّمَالِ","قَعِیْدٌ"]},{"w":["مَا","یَلْفِظُ","مِنْ","قَوْلٍ","اِلَّا","لَدَیْهِ","رَقِیْبٌ","عَتِیْدٌ"]},{"w":["وَجَآءَتْ","سَكْرَةُ","الْمَوْتِ","بِالْحَقِّ ؕ","ذٰلِكَ","مَا","كُنْتَ","مِنْهُ","تَحِیْدُ"]},{"w":["وَنُفِخَ","فِی","الصُّوْرِ ؕ","ذٰلِكَ