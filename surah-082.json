{"surah":82,"ar":"الانفطار","en":"Al-Infitar","ayahs":19,"verses":[{"w":["اِذَا","السَّمَآءُ","انْفَطَرَتْ"]},{"w":["وَاِذَا","الْكَوَاكِبُ","انْتَثَرَتْ"]},{"w":["وَاِذَا","الْبِحَارُ","فُجِّرَتْ"]},{"w":["وَاِذَا","الْقُبُوْرُ","بُعْثِرَتْ"]},{"w":["عَلِمَتْ","نَفْسٌ","مَّا","قَدَّمَتْ","وَاَخَّرَتْ"]},{"w":["یٰۤاَیُّهَا","الْاِنْسَانُ","مَا","غَرَّكَ","بِرَبِّكَ","الْكَرِیْمِ"]},{"w":["الَّذِیْ","خَلَقَكَ","فَسَوّٰىكَ","فَعَدَلَكَ"]},{"w":["فِیْۤ","اَیِّ","صُوْرَةٍ","مَّا","شَآءَ","رَكَّبَكَ"]},{"w":["كَلَّا","بَلْ","تُكَذِّبُوْنَ","بِالدِّیْنِ"]},{"w":["وَاِنَّ","عَلَیْكُمْ","لَحٰفِظِیْنَ"]},{"w":["كِرَامًا","كَاتِبِیْنَ"]},{"w":["یَعْلَمُوْنَ","مَا","تَفْعَلُوْنَ"]},{"w":["اِنَّ","الْاَبْرَارَ","لَفِیْ","نَعِیْمٍ"]},{"w":["وَاِنَّ","الْفُجَّارَ","لَفِیْ","جَحِیْمٍ"]},{"w":["یَّصْلَوْنَهَا","یَوْمَ","الدِّیْنِ"]},{"w":["وَمَا","هُمْ","عَنْهَا","بِغَآىِٕبِیْنَ"]},{"w":["وَمَاۤ","اَدْرٰىكَ","مَا","یَوْمُ","الدِّیْنِ"]},{"w":["ثُمَّ","مَاۤ","اَدْرٰىكَ","مَا","یَوْمُ","الدِّیْنِ"]},{"w":["یَوْمَ","لَا","تَمْلِكُ","نَفْسٌ","لِّنَفْسٍ","شَیْـًٔا ؕ","وَالْاَمْرُ","یَوْمَىِٕذٍ","لِّلّٰهِ"]}]}