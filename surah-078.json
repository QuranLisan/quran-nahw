{"surah":78,"ar":"النبأ","en":"An-Naba","ayahs":40,"verses":[{"w":["عَمَّ","یَتَسَآءَلُوْنَ"]},{"w":["عَنِ","النَّبَاِ","الْعَظِیْمِ"]},{"w":["الَّذِیْ","هُمْ","فِیْهِ","مُخْتَلِفُوْنَ"]},{"w":["كَلَّا","سَیَعْلَمُوْنَ"]},{"w":["ثُمَّ","كَلَّا","سَیَعْلَمُوْنَ"]},{"w":["اَلَمْ","نَجْعَلِ","الْاَرْضَ","مِهٰدًا"]},{"w":["وَّالْجِبَالَ","اَوْتَادًا"]},{"w":["وَّخَلَقْنٰكُمْ","اَزْوَاجًا"]},{"w":["وَّجَعَلْنَا","نَوْمَكُمْ","سُبَاتًا"]},{"w":["وَّجَعَلْنَا","الَّیْلَ","لِبَاسًا"]},{"w":["وَّجَعَلْنَا","النَّهَارَ","مَعَاشًا"]},{"w":["وَّبَنَیْنَا","فَوْقَكُمْ","سَبْعًا","شِدَادًا"]},{"w":["وَّجَعَلْنَا","سِرَاجًا","وَّهَّاجًا"]},{"w":["وَّاَنْزَلْنَا","مِنَ","الْمُعْصِرٰتِ","مَآءً","ثَجَّاجًا"]},{"w":["لِّنُخْرِجَ","بِهٖ","حَبًّا","وَّنَبَاتًا"]},{"w":["وَّجَنّٰتٍ","اَلْفَافًا"]},{"w":["اِنَّ","یَوْمَ","الْفَصْلِ","كَانَ","مِیْقَاتًا"]},{"w":["یَّوْمَ","یُنْفَخُ","فِی","الصُّوْرِ","فَتَاْتُوْنَ","اَفْوَاجًا"]},{"w":["وَّفُتِحَتِ","السَّمَآءُ","فَكَانَتْ","اَبْوَابًا"]},{"w":["وَّسُیِّرَتِ","الْجِبَالُ","فَكَانَتْ","سَرَابًا"]},{"w":["اِنَّ","جَهَنَّمَ","كَانَتْ","مِرْصَادًا"]},{"w":["لِّلطَّاغِیْنَ","مَاٰبًا"]},{"w":["لّٰبِثِیْنَ","فِیْهَاۤ","اَحْقَابًا"]},{"w":["لَا","یَذُوْقُوْنَ","فِیْهَا","بَرْدًا","وَّلَا","شَرَابًا"]},{"w":["اِلَّا","حَمِیْمًا","وَّغَسَّاقًا"]},{"w":["جَزَآءً","وِّفَاقًا"]},{"w":["اِنَّهُمْ","كَانُوْا","لَا","یَرْجُوْنَ","حِسَابًا"]},{"w":["وَّكَذَّبُوْا","بِاٰیٰتِنَا","كِذَّابًا"]},{"w":["وَكُلَّ","شَیْءٍ","اَحْصَیْنٰهُ","كِتٰبًا"]},{"w":["فَذُوْقُوْا","فَلَنْ","نَّزِیْدَكُمْ","اِلَّا","عَذَابًا"]},{"w":["اِنَّ","لِلْمُتَّقِیْنَ","مَفَازًا"]},{"w":["حَدَآىِٕقَ","وَاَعْنَابًا"]},{"w":["وَّكَوَاعِبَ","اَتْرَابًا"]},{"w":["وَّكَاْسًا","دِهَاقًا"]},{"w":["لَا","یَسْمَعُوْنَ","فِیْهَا","لَغْوًا","وَّلَا","كِذّٰبًا"]},{"w":["جَزَآءً","مِّنْ","رَّبِّكَ","عَطَآءً","حِسَابًا"]},{"w":["رَّبِّ","السَّمٰوٰتِ","وَالْاَرْضِ","وَمَا","بَیْنَهُمَا","الرَّحْمٰنِ","لَا","یَمْلِكُوْنَ","مِنْهُ","خِطَابًا"]},{"w":["یَوْمَ","یَقُوْمُ","الرُّوْحُ","وَالْمَلٰٓىٕ