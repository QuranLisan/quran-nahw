{"surah":87,"ar":"الأعلى","en":"Al-Ala","ayahs":19,"verses":[{"w":["سَبِّحِ","اسْمَ","رَبِّكَ","الْاَعْلَی"]},{"w":["الَّذِیْ","خَلَقَ","فَسَوّٰی"]},{"w":["وَالَّذِیْ","قَدَّرَ","فَهَدٰی"]},{"w":["وَالَّذِیْۤ","اَخْرَجَ","الْمَرْعٰی"]},{"w":["فَجَعَلَهٗ","غُثَآءً","اَحْوٰی"]},{"w":["سَنُقْرِئُكَ","فَلَا","تَنْسٰۤی"]},{"w":["اِلَّا","مَا","شَآءَ","اللّٰهُ ؕ","اِنَّهٗ","یَعْلَمُ","الْجَهْرَ","وَمَا","یَخْفٰی"]},{"w":["وَنُیَسِّرُكَ","لِلْیُسْرٰی"]},{"w":["فَذَكِّرْ","اِنْ","نَّفَعَتِ","الذِّكْرٰی"]},{"w":["سَیَذَّكَّرُ","مَنْ","یَّخْشٰی"]},{"w":["وَیَتَجَنَّبُهَا","الْاَشْقَی"]},{"w":["الَّذِیْ","یَصْلَی","النَّارَ","الْكُبْرٰی"]},{"w":["ثُمَّ","لَا","یَمُوْتُ","فِیْهَا","وَلَا","یَحْیٰی"]},{"w":["قَدْ","اَفْلَحَ","مَنْ","تَزَكّٰی"]},{"w":["وَذَكَرَ","اسْمَ","رَبِّهٖ","فَصَلّٰی"]},{"w":["بَلْ","تُؤْثِرُوْنَ","الْحَیٰوةَ","الدُّنْیَا"]},{"w":["وَالْاٰخِرَةُ","خَیْرٌ","وَّاَبْقٰی"]},{"w":["اِنَّ","هٰذَا","لَفِی","الصُّحُفِ","الْاُوْلٰی"]},{"w":["صُحُفِ","اِبْرٰهِیْمَ","وَمُوْسٰی"]}]}