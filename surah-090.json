{"surah":90,"ar":"البلد","en":"Al-Balad","ayahs":20,"verses":[{"w":["لَاۤ","اُقْسِمُ","بِهٰذَا","الْبَلَدِ"]},{"w":["وَاَنْتَ","حِلٌّۢ","بِهٰذَا","الْبَلَدِ"]},{"w":["وَوَالِدٍ","وَّمَا","وَلَدَ"]},{"w":["لَقَدْ","خَلَقْنَا","الْاِنْسَانَ","فِیْ","كَبَدٍ"]},{"w":["اَیَحْسَبُ","اَنْ","لَّنْ","یَّقْدِرَ","عَلَیْهِ","اَحَدٌ"]},{"w":["یَقُوْلُ","اَهْلَكْتُ","مَالًا","لُّبَدًا"]},{"w":["اَیَحْسَبُ","اَنْ","لَّمْ","یَرَهٗۤ","اَحَدٌ"]},{"w":["اَلَمْ","نَجْعَلْ","لَّهٗ","عَیْنَیْنِ"]},{"w":["وَلِسَانًا","وَّشَفَتَیْنِ"]},{"w":["وَهَدَیْنٰهُ","النَّجْدَیْنِ"]},{"w":["فَلَا","اقْتَحَمَ","الْعَقَبَةَ"]},{"w":["وَمَاۤ","اَدْرٰىكَ","مَا","الْعَقَبَةُ"]},{"w":["فَكُّ","رَقَبَةٍ"]},{"w":["اَوْ","اِطْعٰمٌ","فِیْ","یَوْمٍ","ذِیْ","مَسْغَبَةٍ"]},{"w":["یَّتِیْمًا","ذَا","مَقْرَبَةٍ"]},{"w":["اَوْ","مِسْكِیْنًا","ذَا","مَتْرَبَةٍ"]},{"w":["ثُمَّ","كَانَ","مِنَ","الَّذِیْنَ","اٰمَنُوْا","وَتَوَاصَوْا","بِالصَّبْرِ","وَتَوَاصَوْا","بِالْمَرْحَمَةِ"]},{"w":["اُولٰٓىِٕكَ","اَصْحٰبُ","الْمَیْمَنَةِ"]},{"w":["وَالَّذِیْنَ","كَفَرُوْا","بِاٰیٰتِنَا","هُمْ","اَصْحٰبُ","الْمَشْـَٔمَةِ"]},{"w":["عَلَیْهِمْ","نَارٌ","مُّؤْصَدَةٌ"]}]}