{"surah":37,"ar":"الصافات","en":"As-Saffat","ayahs":182,"verses":[{"w":["وَالصّٰٓفّٰتِ","صَفًّا"]},{"w":["فَالزّٰجِرٰتِ","زَجْرًا"]},{"w":["فَالتّٰلِیٰتِ","ذِكْرًا"]},{"w":["اِنَّ","اِلٰهَكُمْ","لَوَاحِدٌ"]},{"w":["رَبُّ","السَّمٰوٰتِ","وَالْاَرْضِ","وَمَا","بَیْنَهُمَا","وَرَبُّ","الْمَشَارِقِ"]},{"w":["اِنَّا","زَیَّنَّا","السَّمَآءَ","الدُّنْیَا","بِزِیْنَةِ","لْكَوَاكِبِ"]},{"w":["وَحِفْظًا","مِّنْ","كُلِّ","شَیْطٰنٍ","مَّارِدٍ"]},{"w":["لَا","یَسَّمَّعُوْنَ","اِلَی","الْمَلَاِ","الْاَعْلٰی","وَیُقْذَفُوْنَ","مِنْ","كُلِّ","جَانِبٍ"]},{"w":["دُحُوْرًا","وَّلَهُمْ","عَذَابٌ","وَّاصِبٌ"]},{"w":["اِلَّا","مَنْ","خَطِفَ","الْخَطْفَةَ","فَاَتْبَعَهٗ","شِهَابٌ","ثَاقِبٌ"]},{"w":["فَاسْتَفْتِهِمْ","اَهُمْ","اَشَدُّ","خَلْقًا","اَمْ","مَّنْ","خَلَقْنَا ؕ","اِنَّا","خَلَقْنٰهُمْ","مِّنْ","طِیْنٍ","لَّازِبٍ"]},{"w":["بَلْ","عَجِبْتَ","وَیَسْخَرُوْنَ"]},{"w":["وَاِذَا","ذُكِّرُوْا","لَا","یَذْكُرُوْنَ"]},{"w":["وَاِذَا","رَاَوْا","اٰیَةً","یَّسْتَسْخِرُوْنَ"]},{"w":["وَقَالُوْۤا","اِنْ","هٰذَاۤ","اِلَّا","سِحْرٌ","مُّبِیْنٌ"]},{"w":["ءَاِذَا","مِتْنَا","وَكُنَّا","تُرَابًا","وَّعِظَامًا","ءَاِنَّا","لَمَبْعُوْثُوْنَ"]},{"w":["اَوَاٰبَآؤُنَا","الْاَوَّلُوْنَ"]},{"w":["قُلْ","نَعَمْ","وَاَنْتُمْ","دَاخِرُوْنَ"]},{"w":["فَاِنَّمَا","هِیَ","زَجْرَةٌ","وَّاحِدَةٌ","فَاِذَا","هُمْ","یَنْظُرُوْنَ"]},{"w":["وَقَالُوْا","یٰوَیْلَنَا","هٰذَا","یَوْمُ","الدِّیْنِ"]},{"w":["هٰذَا","یَوْمُ","الْفَصْلِ","الَّذِیْ","كُنْتُمْ","بِهٖ","تُكَذِّبُوْنَ"]},{"w":["اُحْشُرُوا","الَّذِیْنَ","ظَلَمُوْا","وَاَزْوَاجَهُمْ","وَمَا","كَانُوْا","یَعْبُدُوْنَ"]},{"w":["مِنْ","دُوْنِ","اللّٰهِ","فَاهْدُوْهُمْ","اِلٰی","صِرَاطِ","الْجَحِیْمِ"]},{"w":["وَقِفُوْهُمْ","اِنَّهُمْ","مَّسْـُٔوْلُوْنَ"]},{"w":["مَا","لَكُمْ","لَا","تَنَاصَرُوْنَ"]},{"w":["بَلْ","هُمُ","الْیَوْمَ","مُسْتَسْلِمُوْنَ"]},{"w":["وَاَقْبَلَ","بَعْضُهُمْ","عَلٰی","بَعْضٍ","یَّتَسَآءَلُوْنَ"]},{"w":["قَالُوْۤا","اِنَّكُمْ","كُنْتُمْ","تَاْتُوْنَنَا","عَنِ","الْیَمِیْنِ"]},{"w":["قَالُوْا","بَلْ","لَّمْ","تَكُوْنُوْا","مُؤْمِنِیْنَ"]},{"w":["وَمَا","كَانَ","لَنَا","عَلَیْكُمْ","مِّنْ","سُلْطٰنٍ","بَلْ","كُنْتُمْ","قَوْمًا","طٰغِیْنَ"]},{"w":["فَحَقَّ","عَلَیْنَا","قَوْلُ","رَبِّنَاۤ","اِنَّا","لَذَآىِٕقُوْنَ"]},{"w":["فَاَغْوَیْنٰكُمْ","اِنَّا","كُنَّا","غٰوِیْنَ"]},{"w":["فَاِنَّهُمْ","یَوْمَىِٕذٍ","فِی","الْعَذَابِ","مُشْتَرِكُوْنَ"]},{"w":["اِنَّا","كَذٰلِكَ","نَفْعَلُ","بِالْمُجْرِمِیْنَ"]},{"w":["اِنَّهُمْ","كَانُوْۤا","اِذَا","قِیْلَ","لَهُمْ","لَاۤ","اِلٰهَ","اِلَّا","اللّٰهُ","یَسْتَكْبِرُوْنَ"]},{"w":["وَیَقُوْلُوْنَ","اَىِٕنَّا","لَتَارِكُوْۤا","اٰلِهَتِنَا","لِشَاعِرٍ","مَّجْنُوْنٍ"]},{"w":["بَلْ","جَآءَ","بِالْحَقِّ","وَصَدَّقَ","الْمُرْسَلِیْنَ"]},{"w":["اِنَّكُمْ","لَذَآىِٕقُوا","الْعَذَابِ","الْاَلِیْمِ"]},{"w":["وَمَا","تُجْزَوْنَ","اِلَّا","مَا","كُنْتُمْ","تَعْمَلُوْنَ"]},{"w":["اِلَّا","عِبَادَ","اللّٰهِ","الْمُخْلَصِیْنَ"]},{"w":["اُولٰٓىِٕكَ","لَهُمْ","رِزْقٌ","مَّعْلُوْمٌ"]},{"w":["فَوَاكِهُ","وَهُمْ","مُّكْرَمُوْنَ"]},{"w":["فِیْ","جَنّٰتِ","النَّعِیْمِ"]},{"w":["عَلٰی","سُرُرٍ","مُّتَقٰبِلِیْنَ"]},{"w":["یُطَافُ","عَلَیْهِمْ","بِكَاْسٍ","مِّنْ","مَّعِیْنٍ"]},{"w":["بَیْضَآءَ","لَذَّةٍ","لِّلشّٰرِبِیْنَ"]},{"w":["لَا","فِیْهَا","غَوْلٌ","وَّلَا","هُمْ","عَنْهَا","یُنْزَفُوْنَ"]},{"w":["وَعِنْدَهُمْ","قٰصِرٰتُ","الطَّرْفِ","عِیْنٌ"]},{"w":["كَاَنَّهُنَّ","بَیْضٌ","مَّكْنُوْنٌ"]},{"w":["فَاَقْبَلَ","بَعْضُهُمْ","عَلٰی","بَعْضٍ","یَّتَسَآءَلُوْنَ"]},{"w":["قَالَ","قَآىِٕلٌ","مِّنْهُمْ","اِنِّیْ","كَانَ","لِیْ","قَرِیْنٌ"]},{"w":["یَّقُوْلُ","اَىِٕنَّكَ","لَمِنَ","الْمُصَدِّقِیْنَ"]},{"w":["ءَاِذَا","مِتْنَا","وَكُنَّا","تُرَابًا","وَّعِظَامًا","ءَاِنَّا","لَمَدِیْنُوْنَ"]},{"w":["قَالَ","هَلْ","اَنْتُمْ","مُّطَّلِعُوْنَ"]},{"w":["فَاطَّلَعَ","فَرَاٰهُ","فِیْ","سَوَآءِ","الْجَحِیْمِ"]},{"w":["قَالَ","تَاللّٰهِ","اِنْ","كِدْتَّ","لَتُرْدِیْنِ"]},{"w":["وَلَوْلَا","نِعْمَةُ","رَبِّیْ","لَكُنْتُ","مِنَ","الْمُحْضَرِیْنَ"]},{"w":["اَفَمَا","نَحْنُ","بِمَیِّتِیْنَ"]},{"w":["اِلَّا","مَوْتَتَنَا","الْاُوْلٰی","وَمَا","نَحْنُ","بِمُعَذَّبِیْنَ"]},{"w":["اِنَّ","هٰذَا","لَهُو