{"surah":44,"ar":"الدخان","en":"Ad-Dukhan","ayahs":59,"verses":[{"w":["حٰمٓ"]},{"w":["وَالْكِتٰبِ","الْمُبِیْنِ"]},{"w":["اِنَّاۤ","اَنْزَلْنٰهُ","فِیْ","لَیْلَةٍ","مُّبٰرَكَةٍ","اِنَّا","كُنَّا","مُنْذِرِیْنَ"]},{"w":["فِیْهَا","یُفْرَقُ","كُلُّ","اَمْرٍ","حَكِیْمٍ"]},{"w":["اَمْرًا","مِّنْ","عِنْدِنَا ؕ","اِنَّا","كُنَّا","مُرْسِلِیْنَ"]},{"w":["رَحْمَةً","مِّنْ","رَّبِّكَ ؕ","اِنَّهٗ","هُوَ","السَّمِیْعُ","الْعَلِیْمُ"]},{"w":["رَبِّ","السَّمٰوٰتِ","وَالْاَرْضِ","وَمَا","بَیْنَهُمَا ","اِنْ","كُنْتُمْ","مُّوْقِنِیْنَ"]},{"w":["لَاۤ","اِلٰهَ","اِلَّا","هُوَ","یُحْیٖ","وَیُمِیْتُ ؕ","رَبُّكُمْ","وَرَبُّ","اٰبَآىِٕكُمُ","الْاَوَّلِیْنَ"]},{"w":["بَلْ","هُمْ","فِیْ","شَكٍّ","یَّلْعَبُوْنَ"]},{"w":["فَارْتَقِبْ","یَوْمَ","تَاْتِی","السَّمَآءُ","بِدُخَانٍ","مُّبِیْنٍ"]},{"w":["یَّغْشَی","النَّاسَ ؕ","هٰذَا","عَذَابٌ","اَلِیْمٌ"]},{"w":["رَبَّنَا","اكْشِفْ","عَنَّا","الْعَذَابَ","اِنَّا","مُؤْمِنُوْنَ"]},{"w":["اَنّٰی","لَهُمُ","الذِّكْرٰی","وَقَدْ","جَآءَهُمْ","رَسُوْلٌ","مُّبِیْنٌ"]},{"w":["ثُمَّ","تَوَلَّوْا","عَنْهُ","وَقَالُوْا","مُعَلَّمٌ","مَّجْنُوْنٌ"]},{"w":["اِنَّا","كَاشِفُوا","الْعَذَابِ","قَلِیْلًا","اِنَّكُمْ","عَآىِٕدُوْنَ"]},{"w":["یَوْمَ","نَبْطِشُ","الْبَطْشَةَ","الْكُبْرٰی","اِنَّا","مُنْتَقِمُوْنَ"]},{"w":["وَلَقَدْ","فَتَنَّا","قَبْلَهُمْ","قَوْمَ","فِرْعَوْنَ","وَجَآءَهُمْ","رَسُوْلٌ","كَرِیْمٌ"]},{"w":["اَنْ","اَدُّوْۤا","اِلَیَّ","عِبَادَ","اللّٰهِ ؕ","اِنِّیْ","لَكُمْ","رَسُوْلٌ","اَمِیْنٌ"]},{"w":["وَّاَنْ","لَّا","تَعْلُوْا","عَلَی","اللّٰهِ ؕ","اِنِّیْۤ","اٰتِیْكُمْ","بِسُلْطٰنٍ","مُّبِیْنٍ"]},{"w":["وَاِنِّیْ","عُذْتُ","بِرَبِّیْ","وَرَبِّكُمْ","اَنْ","تَرْجُمُوْنِ"]},{"w":["وَاِنْ","لَّمْ","تُؤْمِنُوْا","لِیْ","فَاعْتَزِلُوْنِ"]},{"w":["فَدَعَا","رَبَّهٗۤ","اَنَّ","هٰۤؤُلَآءِ","قَوْمٌ","مُّجْرِمُوْنَ"]},{"w":["فَاَسْرِ","بِعِبَادِیْ","لَیْلًا","اِنَّكُمْ","مُّتَّبَعُوْنَ"]},{"w":["وَاتْرُكِ","الْبَحْرَ","رَهْوًا ؕ","اِنَّهُمْ","جُنْدٌ","مُّغْرَقُوْنَ"]},{"w":["كَمْ","تَرَكُوْا","مِنْ","جَنّٰتٍ","وَّعُیُوْنٍ"]},{"w":["وَّزُرُوْعٍ","وَّمَقَامٍ","كَرِیْمٍ"]},{"w":["وَّنَعْمَةٍ","كَانُوْا","فِیْهَا","فٰكِهِیْنَ"]},{"w":["كَذٰلِكَ","وَاَوْرَثْنٰهَا","قَوْمًا","اٰخَرِیْنَ"]},{"w":["فَمَا","بَكَتْ","عَلَیْهِمُ","السَّمَآءُ","وَالْاَرْضُ","وَمَا","كَانُوْا","مُنْظَرِیْنَ"]},{"w":["وَلَقَدْ","نَجَّیْنَا","بَنِیْۤ","اِسْرَآءِیْلَ","مِنَ","الْعَذَابِ","الْمُهِیْنِ"]},{"w":["مِنْ","فِرْعَوْنَ ؕ","اِنَّهٗ","كَانَ","عَالِیًا","مِّنَ","الْمُسْرِفِیْنَ"]},{"w":["وَلَقَدِ","اخْتَرْنٰهُمْ","عَلٰی","عِلْمٍ","عَلَی","الْعٰلَمِیْنَ"]},{"w":["وَاٰتَیْنٰهُمْ","مِّنَ","الْاٰیٰتِ","مَا","فِیْهِ","بَلٰٓؤٌا","مُّبِیْنٌ"]},{"w":["اِنَّ","هٰۤؤُلَآءِ","لَیَقُوْلُوْنَ"]},{"w":["اِنْ","هِیَ","اِلَّا","مَوْتَتُنَا","الْاُوْلٰی","وَمَا","نَحْنُ","بِمُنْشَرِیْنَ"]},{"w":["فَاْتُوْا","بِاٰبَآىِٕنَاۤ","اِنْ","كُنْتُمْ","صٰدِقِیْنَ"]},{"w":["اَهُمْ","خَیْرٌ","اَمْ","قَوْمُ","تُبَّعٍ","وَّالَّذِیْنَ","مِنْ","قَبْلِهِمْ ؕ","اَهْلَكْنٰهُمْ ؗ","اِنَّهُمْ","كَانُوْا","مُجْرِمِیْنَ"]},{"w":["وَمَا","خَلَقْنَا","السَّمٰوٰتِ","وَالْاَرْضَ","وَمَا","بَیْنَهُمَا","لٰعِبِیْنَ"]},{"w":["مَا","خَلَقْنٰهُمَاۤ","اِلَّا","بِالْحَقِّ","وَلٰكِنَّ","اَكْثَرَهُمْ","لَا","یَعْلَمُوْنَ"]},{"w":["اِنَّ","یَوْمَ","الْفَصْلِ","مِیْقَاتُهُمْ","اَجْمَعِیْنَ"]},{"w":["یَوْمَ","لَا","یُغْنِیْ","مَوْلًی","عَنْ","مَّوْلًی","شَیْـًٔا","وَّلَا","هُمْ","یُنْصَرُوْنَ"]},{"w":["اِلَّا","مَنْ","رَّحِمَ","اللّٰهُ ؕ","اِنَّهٗ","هُوَ","الْعَزِیْزُ","الرَّحِیْمُ"]},{"w":["اِنَّ","شَجَرَتَ","الزَّقُّوْمِ"]},{"w":["طَعَامُ","الْاَثِیْمِ"]},{"w":["كَالْمُهْلِ","یَغْلِیْ","فِی","الْبُطُوْنِ"]},{"w":["كَغَلْیِ","الْحَمِیْمِ"]},{"w":["خُذُوْهُ","فَاعْتِلُوْهُ","اِلٰی","سَوَآءِ","الْجَحِیْمِ"]},{"w":["ثُمَّ","صُبُّوْا","فَوْقَ","رَاْسِهٖ","مِنْ","عَذَابِ","الْحَمِیْمِ"]},{"w":["ذُقْ","اِنَّكَ","اَنْتَ","الْعَزِیْزُ","الْكَرِیْمُ"]},{"w":["اِنَّ","هٰذَا","مَا","كُنْتُمْ","بِهٖ","تَمْتَرُوْنَ"]},{"w":["اِنَّ","الْمُتَّقِیْنَ","فِیْ","مَقَامٍ","اَمِیْنٍ"]},{"w":["فِیْ","جَنّٰتٍ","وَّعُیُوْنٍ"]},{"w":["یَّلْبَسُوْنَ","مِنْ","سُنْدُسٍ","وَّاِسْتَبْرَقٍ","مُّتَقٰبِلِیْنَ"]},{"w":["كَذٰلِكَ","وَزَوَّجْنٰهُمْ","بِحُوْرٍ","عِیْنٍ"]},{"w":["یَدْعُوْنَ","فِیْهَا","بِكُلِّ","فَاكِهَةٍ","اٰمِنِیْنَ"]},{"w":["لَا","یَذُوْقُوْنَ","فِیْهَا","الْمَوْتَ","اِلَّا","الْمَوْتَةَ","الْاُوْلٰی","وَوَقٰىهُمْ","عَذَابَ","الْجَحِیْمِ"]},{"w":["فَضْلًا","مِّنْ","رَّبِّكَ ؕ","ذٰلِكَ","هُوَ","الْفَوْزُ","الْعَظِیْمُ"]},{"w":["فَاِنَّمَا","یَسَّرْنٰهُ","بِلِسَانِكَ","لَعَلَّهُمْ","یَتَذَكَّرُوْنَ"]},{"w":["فَارْتَقِبْ","اِنَّهُمْ","مُّرْتَقِبُوْنَ"]}]}