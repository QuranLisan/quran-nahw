{"surah":52,"ar":"الطور","en":"At-Tur","ayahs":49,"verses":[{"w":["وَالطُّوْرِ"]},{"w":["وَكِتٰبٍ","مَّسْطُوْرٍ"]},{"w":["فِیْ","رَقٍّ","مَّنْشُوْرٍ"]},{"w":["وَّالْبَیْتِ","الْمَعْمُوْرِ"]},{"w":["وَالسَّقْفِ","الْمَرْفُوْعِ"]},{"w":["وَالْبَحْرِ","الْمَسْجُوْرِ"]},{"w":["اِنَّ","عَذَابَ","رَبِّكَ","لَوَاقِعٌ"]},{"w":["مَّا","لَهٗ","مِنْ","دَافِعٍ"]},{"w":["یَّوْمَ","تَمُوْرُ","السَّمَآءُ","مَوْرًا"]},{"w":["وَّتَسِیْرُ","الْجِبَالُ","سَیْرًا"]},{"w":["فَوَیْلٌ","یَّوْمَىِٕذٍ","لِّلْمُكَذِّبِیْنَ"]},{"w":["الَّذِیْنَ","هُمْ","فِیْ","خَوْضٍ","یَّلْعَبُوْنَ"]},{"w":["یَوْمَ","یُدَعُّوْنَ","اِلٰی","نَارِ","جَهَنَّمَ","دَعًّا"]},{"w":["هٰذِهِ","النَّارُ","الَّتِیْ","كُنْتُمْ","بِهَا","تُكَذِّبُوْنَ"]},{"w":["اَفَسِحْرٌ","هٰذَاۤ","اَمْ","اَنْتُمْ","لَا","تُبْصِرُوْنَ"]},{"w":["اِصْلَوْهَا","فَاصْبِرُوْۤا","اَوْ","لَا","تَصْبِرُوْا","سَوَآءٌ","عَلَیْكُمْ ؕ","اِنَّمَا","تُجْزَوْنَ","مَا","كُنْتُمْ","تَعْمَلُوْنَ"]},{"w":["اِنَّ","الْمُتَّقِیْنَ","فِیْ","جَنّٰتٍ","وَّنَعِیْمٍ"]},{"w":["فٰكِهِیْنَ","بِمَاۤ","اٰتٰىهُمْ","رَبُّهُمْ","وَوَقٰىهُمْ","رَبُّهُمْ","عَذَابَ","الْجَحِیْمِ"]},{"w":["كُلُوْا","وَاشْرَبُوْا","هَنِیْٓـًٔا","بِمَا","كُنْتُمْ","تَعْمَلُوْنَ"]},{"w":["مُتَّكِـِٕیْنَ","عَلٰی","سُرُرٍ","مَّصْفُوْفَةٍ","وَزَوَّجْنٰهُمْ","بِحُوْرٍ","عِیْنٍ"]},{"w":["وَالَّذِیْنَ","اٰمَنُوْا","وَاتَّبَعَتْهُمْ","ذُرِّیَّتُهُمْ","بِاِیْمَانٍ","اَلْحَقْنَا","بِهِمْ","ذُرِّیَّتَهُمْ","وَمَاۤ","اَلَتْنٰهُمْ","مِّنْ","عَمَلِهِمْ","مِّنْ","شَیْءٍ ؕ","كُلُّ","امْرِىۢ","بِمَا","كَسَبَ","رَهِیْنٌ"]},{"w":["وَاَمْدَدْنٰهُمْ","بِفَاكِهَةٍ","وَّلَحْمٍ","مِّمَّا","یَشْتَهُوْنَ"]},{"w":["یَتَنَازَعُوْنَ","فِیْهَا","كَاْسًا","لَّا","لَغْوٌ","فِیْهَا","وَلَا","تَاْثِیْمٌ"]},{"w":["وَیَطُوْفُ","عَلَیْهِمْ","غِلْمَانٌ","لَّهُمْ","كَاَنَّهُمْ","لُؤْلُؤٌ","مَّكْنُوْنٌ"]},{"w":["وَاَقْبَلَ","بَعْضُهُمْ","عَلٰی","بَعْضٍ","یَّتَسَآءَلُوْنَ"]},{"w":["قَالُوْۤا","اِنَّا","كُنَّا","قَبْلُ","فِیْۤ","اَهْلِنَا","مُشْفِقِیْنَ"]},{"w":["فَمَنَّ","اللّٰهُ","عَلَیْنَا","وَوَقٰىنَا","عَذَابَ","السَّمُوْمِ