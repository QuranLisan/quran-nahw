{"surah":42,"ar":"الشورى","en":"Ash-Shura","ayahs":53,"verses":[{"w":["حٰمٓ"]},{"w":["عٓسٓقٓ"]},{"w":["كَذٰلِكَ","یُوْحِیْۤ","اِلَیْكَ","وَاِلَی","الَّذِیْنَ","مِنْ","قَبْلِكَ","اللّٰهُ","الْعَزِیْزُ","الْحَكِیْمُ"]},{"w":["لَهٗ","مَا","فِی","السَّمٰوٰتِ","وَمَا","فِی","الْاَرْضِ ؕ","وَهُوَ","الْعَلِیُّ","الْعَظِیْمُ"]},{"w":["تَكَادُ","السَّمٰوٰتُ","یَتَفَطَّرْنَ","مِنْ","فَوْقِهِنَّ","وَالْمَلٰٓىِٕكَةُ","یُسَبِّحُوْنَ","بِحَمْدِ","رَبِّهِمْ","وَیَسْتَغْفِرُوْنَ","لِمَنْ","فِی","الْاَرْضِ ؕ","اَلَاۤ","اِنَّ","اللّٰهَ","هُوَ","الْغَفُوْرُ","الرَّحِیْمُ"]},{"w":["وَالَّذِیْنَ","اتَّخَذُوْا","مِنْ","دُوْنِهٖۤ","اَوْلِیَآءَ","اللّٰهُ","حَفِیْظٌ","عَلَیْهِمْ ؗ","وَمَاۤ","اَنْتَ","عَلَیْهِمْ","بِوَكِیْلٍ"]},{"w":["وَكَذٰلِكَ","اَوْحَیْنَاۤ","اِلَیْكَ","قُرْاٰنًا","عَرَبِیًّا","لِّتُنْذِرَ","اُمَّ","الْقُرٰی","وَمَنْ","حَوْلَهَا","وَتُنْذِرَ","یَوْمَ","الْجَمْعِ","لَا","رَیْبَ","فِیْهِ ؕ","فَرِیْقٌ","فِی","الْجَنَّةِ","وَفَرِیْقٌ","فِی","السَّعِیْرِ"]},{"w":["وَلَوْ","شَآءَ","اللّٰهُ","لَجَعَلَهُمْ","اُمَّةً","وَّاحِدَةً","وَّلٰكِنْ","یُّدْخِلُ","مَنْ","یَّشَآءُ","فِیْ","رَحْمَتِهٖ ؕ","وَالظّٰلِمُوْنَ","مَا","لَهُمْ","مِّنْ","وَّلِیٍّ","وَّلَا","نَصِیْرٍ"]},{"w":["اَمِ","اتَّخَذُوْا","مِنْ","دُوْنِهٖۤ","اَوْلِیَآءَ","فَاللّٰهُ","هُوَ","الْوَلِیُّ","وَهُوَ","یُحْیِ","الْمَوْتٰی ؗ","وَهُوَ","عَلٰی","كُلِّ","شَیْءٍ","قَدِیْرٌ"]},{"w":["وَمَا","اخْتَلَفْتُمْ","فِیْهِ","مِنْ","شَیْءٍ","فَحُكْمُهٗۤ","اِلَی","اللّٰهِ ؕ","ذٰلِكُمُ","اللّٰهُ","رَبِّیْ","عَلَیْهِ","تَوَكَّلْتُ","وَاِلَیْهِ","اُنِیْبُ"]},{"w":["فَاطِرُ","السَّمٰوٰتِ","وَالْاَرْضِ ؕ","جَعَلَ","لَكُمْ","مِّنْ","اَنْفُسِكُمْ","اَزْوَاجًا","وَّمِنَ","الْاَنْعَامِ","اَزْوَاجًا","یَذْرَؤُكُمْ","فِیْهِ ؕ","لَیْسَ","كَمِثْلِهٖ","شَیْءٌ","وَهُوَ","السَّمِیْعُ","الْبَصِیْرُ"]},{"w":["لَهٗ","مَقَالِیْدُ","السَّمٰوٰتِ","وَالْاَرْضِ","یَبْسُطُ","الرِّزْقَ","لِمَنْ","یَّشَآءُ","وَیَقْدِرُ ؕ","اِنَّهٗ","بِكُلِّ","شَیْءٍ","عَلِیْمٌ"]},{"w":["شَرَعَ","لَكُمْ","مِّنَ","الدِّیْنِ","مَا","وَصّٰی","بِهٖ","نُوْحًا","وَّالَّذِیْۤ","اَوْحَیْنَاۤ","اِلَیْكَ","وَمَا","وَصَّیْنَا","بِهٖۤ","اِبْرٰهِیْمَ","وَمُوْسٰی","وَعِیْسٰۤی","اَنْ","اَقِیْمُوا","الدِّیْنَ","وَلَا","تَتَفَرَّقُوْا","فِیْهِ ؕ","كَبُرَ","عَلَی","الْمُشْرِكِیْنَ","مَا","تَدْعُوْهُمْ","اِلَیْهِ ؕ","اَللّٰهُ","یَجْتَبِیْۤ","اِلَیْهِ","مَنْ","یَّشَآءُ","وَیَهْدِیْۤ","اِلَیْهِ","مَنْ","یُّنِیْبُ"]},{"w":["وَمَا","تَفَرَّقُوْۤا","اِلَّا","مِنْ","بَعْدِ","مَا","جَآءَهُمُ","الْعِلْمُ","بَغْیًا","بَیْنَهُمْ ؕ","وَلَوْلَا","كَلِمَةٌ","سَبَقَتْ","مِنْ","رَّبِّكَ","اِلٰۤی","اَجَلٍ","مُّسَمًّی","لَّقُضِیَ","بَیْنَهُمْ ؕ","وَاِنَّ","الَّذِیْنَ","اُوْرِثُوا","الْكِتٰبَ","مِنْ","بَعْدِهِمْ","لَفِیْ","شَكٍّ","مِّنْهُ","مُرِیْبٍ"]},{"w":["فَلِذٰلِكَ","فَادْعُ","وَاسْتَقِمْ","كَمَاۤ","اُمِرْتَ","وَلَا","تَتَّبِعْ","اَهْوَآءَهُمْ","وَقُلْ","اٰمَنْتُ","بِمَاۤ","اَنْزَلَ","اللّٰهُ","مِنْ","كِتٰبٍ","وَاُمِرْتُ","لِاَعْدِلَ","بَیْنَكُمْ ؕ","اَللّٰهُ","رَبُّنَا","وَرَبُّكُمْ ؕ","لَنَاۤ","اَعْمَالُنَا","وَلَكُمْ","اَعْمَالُكُمْ ؕ","لَا","حُجَّةَ","بَیْنَنَا","وَبَیْنَكُمْ ؕ","اَللّٰهُ","یَجْمَعُ","بَیْنَنَا","وَاِلَیْهِ","الْمَصِیْرُ"]},{"w":["وَالَّذِیْنَ","یُحَآجُّوْنَ","فِی","اللّٰهِ","مِنْ","بَعْدِ","مَا","اسْتُجِیْبَ","لَهٗ","حُجَّتُهُمْ","دَاحِضَةٌ","عِنْدَ","رَبِّهِمْ","وَعَلَیْهِمْ","غَضَبٌ","وَّلَهُمْ","عَذَابٌ","شَدِیْدٌ"]},{"w":["اَللّٰهُ","الَّذِیْۤ","اَنْزَلَ","الْكِتٰبَ","بِالْحَقِّ","وَالْمِیْزَانَ ؕ","وَمَا","یُدْرِیْكَ","لَعَلَّ","السَّاعَةَ","قَرِیْبٌ"]},{"w":["یَسْتَعْجِلُ","بِهَا","الَّذِیْنَ","لَا","یُؤْمِنُوْنَ","بِهَا","وَالَّذِیْنَ","اٰمَنُوْا","مُشْفِقُوْنَ","مِنْهَا","وَیَعْلَمُوْنَ","اَنَّهَا","الْحَقُّ ؕ","اَلَاۤ","اِنَّ","الَّذِیْنَ","یُمَارُوْنَ","فِی","السَّاعَةِ","لَفِیْ","ضَلٰلٍ","بَعِیْدٍ"]},{"w":["اَللّٰهُ","لَطِیْفٌ","بِعِبَادِهٖ","یَرْزُقُ","مَنْ","یَّشَآءُ","وَهُوَ","الْقَوِیُّ","الْعَزِیْزُ"]},{"w":["مَنْ","كَانَ","یُرِیْدُ","حَرْثَ","الْاٰخِرَةِ","نَزِدْ","لَهٗ","فِیْ","حَرْثِهٖ","وَمَنْ","كَانَ","یُرِیْدُ","حَرْثَ","الدُّنْیَا","نُؤْتِهٖ","مِنْهَا","وَمَا","لَهٗ","فِی","الْاٰخِرَةِ","مِنْ","نَّصِیْبٍ"]},{"w":["اَمْ","لَهُمْ","شُرَكٰٓؤُا","شَرَعُوْا","لَهُمْ","مِّنَ","الدِّیْنِ","مَا","لَمْ","یَاْذَنْ","بِهِ","اللّٰهُ ؕ","وَلَوْلَا","كَلِمَةُ","الْفَصْلِ","لَقُضِیَ","بَیْنَهُمْ ؕ","وَاِنَّ","الظّٰلِمِیْنَ","لَهُمْ","عَذَابٌ","اَلِیْمٌ"]},{"w":["تَرَی","الظّٰلِمِیْنَ","مُشْفِقِیْنَ","مِمَّا","كَسَبُوْا","وَهُوَ","وَاقِعٌ","بِهِمْ ؕ","وَالَّذِیْنَ","اٰمَنُوْا","وَعَمِلُوا","الصّٰلِحٰتِ","فِیْ","رَوْضٰتِ","الْجَنّٰتِ","لَهُمْ","مَّا","یَشَآءُوْنَ","عِنْدَ","رَبِّهِمْ ؕ","ذٰلِكَ","هُوَ","الْفَضْلُ","الْكَبِیْرُ"]},{"w":["ذٰلِكَ","الَّذِیْ","یُبَشِّرُ","اللّٰهُ","عِبَادَهُ","الَّذِیْنَ","اٰمَنُوْا","وَعَمِلُوا","الصّٰلِحٰتِ ؕ","قُلْ","لَّاۤ","اَسْـَٔلُكُمْ","عَلَیْهِ","اَجْرًا","اِلَّا","الْمَوَدَّةَ","فِی","الْقُرْبٰی ؕ","وَمَنْ","یَّقْتَرِفْ","حَسَنَةً","نَّزِدْ","لَهٗ","فِیْهَا","حُسْنًا ؕ","اِنَّ","اللّٰهَ","غَفُوْرٌ","شَكُوْرٌ"]},{"w":["اَمْ","یَقُوْلُوْنَ","افْتَرٰی","عَلَی","اللّٰهِ","كَذِبًا","فَاِنْ","یَّشَاِ","اللّٰهُ","یَخْتِمْ","عَلٰی","قَلْبِكَ ؕ","وَیَمْحُ","اللّٰهُ","الْبَاطِلَ","وَیُحِقُّ","الْحَقَّ","بِكَلِمٰتِهٖ ؕ","اِنَّهٗ","عَلِیْمٌۢ","بِذَاتِ","الصُّدُوْرِ"]},{"w":["وَهُوَ","الَّذِیْ","یَقْبَلُ","التَّوْبَةَ","عَنْ","عِبَادِهٖ","وَیَعْفُوْا","عَنِ","السَّیِّاٰتِ","وَیَعْلَمُ","مَا","تَفْعَلُوْنَ"]},{"w":["وَیَسْتَجِیْبُ","الَّذِیْنَ","اٰمَنُوْا","وَعَمِلُوا","الصّٰلِحٰتِ","وَیَزِیْدُهُمْ","مِّنْ","فَضْلِهٖ ؕ","وَالْكٰفِرُوْنَ","لَهُمْ","عَذَابٌ","شَدِیْدٌ"]},{"w":["وَلَوْ","بَسَطَ","اللّٰهُ","الرِّزْقَ","لِعِبَادِهٖ","لَبَغَوْا","فِی","الْاَرْضِ","وَلٰكِنْ","یُّنَزِّلُ","بِقَدَرٍ","مَّا","یَشَآءُ ؕ","اِنَّهٗ","بِعِبَادِهٖ","خَبِیْرٌ","بَصِیْرٌ"]},{"w":["وَهُوَ","الَّذِیْ","یُنَزِّلُ","الْغَیْثَ","مِنْ","بَعْدِ","مَا","قَنَطُوْا","وَیَنْشُرُ","رَحْمَتَهٗ ؕ","وَهُوَ","الْوَلِیُّ","الْحَمِیْدُ"]},{"w":["وَمِنْ","اٰیٰتِهٖ","خَلْقُ","السَّمٰوٰتِ","وَالْاَرْضِ","وَمَا","بَثَّ","فِیْهِمَا","مِنْ","دَآبَّةٍ ؕ","وَهُوَ","عَلٰی","جَمْعِهِمْ","اِذَا","یَشَآءُ","قَدِیْرٌ"]},{"w":["وَمَاۤ","اَصَابَكُمْ","مِّنْ","مُّصِیْبَةٍ","فَبِمَا","كَسَبَتْ","اَیْدِیْ