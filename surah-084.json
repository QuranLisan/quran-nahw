{"surah":84,"ar":"الانشقاق","en":"Al-Inshiqaq","ayahs":25,"verses":[{"w":["اِذَا","السَّمَآءُ","انْشَقَّتْ"]},{"w":["وَاَذِنَتْ","لِرَبِّهَا","وَحُقَّتْ"]},{"w":["وَاِذَا","الْاَرْضُ","مُدَّتْ"]},{"w":["وَاَلْقَتْ","مَا","فِیْهَا","وَتَخَلَّتْ"]},{"w":["وَاَذِنَتْ","لِرَبِّهَا","وَحُقَّتْ"]},{"w":["یٰۤاَیُّهَا","الْاِنْسَانُ","اِنَّكَ","كَادِحٌ","اِلٰی","رَبِّكَ","كَدْحًا","فَمُلٰقِیْهِ"]},{"w":["فَاَمَّا","مَنْ","اُوْتِیَ","كِتٰبَهٗ","بِیَمِیْنِهٖ"]},{"w":["فَسَوْفَ","یُحَاسَبُ","حِسَابًا","یَّسِیْرًا"]},{"w":["وَّیَنْقَلِبُ","اِلٰۤی","اَهْلِهٖ","مَسْرُوْرًا"]},{"w":["وَاَمَّا","مَنْ","اُوْتِیَ","كِتٰبَهٗ","وَرَآءَ","ظَهْرِهٖ"]},{"w":["فَسَوْفَ","یَدْعُوْا","ثُبُوْرًا"]},{"w":["وَّیَصْلٰی","سَعِیْرًا"]},{"w":["اِنَّهٗ","كَانَ","فِیْۤ","اَهْلِهٖ","مَسْرُوْرًا"]},{"w":["اِنَّهٗ","ظَنَّ","اَنْ","لَّنْ","یَّحُوْرَ"]},{"w":["بَلٰۤی","اِنَّ","رَبَّهٗ","كَانَ","بِهٖ","بَصِیْرًا"]},{"w":["فَلَاۤ","اُقْسِمُ","بِالشَّفَقِ"]},{"w":["وَالَّیْلِ","وَمَا","وَسَقَ"]},{"w":["وَالْقَمَرِ","اِذَا","اتَّسَقَ"]},{"w":["لَتَرْكَبُنَّ","طَبَقًا","عَنْ","طَبَقٍ"]},{"w":["فَمَا","لَهُمْ","لَا","یُؤْمِنُوْنَ"]},{"w":["وَاِذَا","قُرِئَ","عَلَیْهِمُ","الْقُرْاٰنُ","لَا","یَسْجُدُوْنَ"]},{"w":["بَلِ","الَّذِیْنَ","كَفَرُوْا","یُكَذِّبُوْنَ"]},{"w":["وَاللّٰهُ","اَعْلَمُ","بِمَا","یُوْعُوْنَ"]},{"w":["فَبَشِّرْهُمْ","بِعَذَابٍ","اَلِیْمٍ"]},{"w":["اِلَّا","الَّذِیْنَ","اٰمَنُوْا","وَعَمِلُوا","الصّٰلِحٰتِ","لَهُمْ","اَجْرٌ","غَیْرُ","مَمْنُوْنٍ"]}]}