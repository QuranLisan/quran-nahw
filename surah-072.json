{"surah":72,"ar":"الجن","en":"Al-Jinn","ayahs":28,"verses":[{"w":["قُلْ","اُوْحِیَ","اِلَیَّ","اَنَّهُ","اسْتَمَعَ","نَفَرٌ","مِّنَ","الْجِنِّ","فَقَالُوْۤا","اِنَّا","سَمِعْنَا","قُرْاٰنًا","عَجَبًا"]},{"w":["یَّهْدِیْۤ","اِلَی","الرُّشْدِ","فَاٰمَنَّا","بِهٖ ؕ","وَلَنْ","نُّشْرِكَ","بِرَبِّنَاۤ","اَحَدًا"]},{"w":["وَّاَنَّهٗ","تَعٰلٰی","جَدُّ","رَبِّنَا","مَا","اتَّخَذَ","صَاحِبَةً","وَّلَا","وَلَدًا"]},{"w":["وَّاَنَّهٗ","كَانَ","یَقُوْلُ","سَفِیْهُنَا","عَلَی","اللّٰهِ","شَطَطًا"]},{"w":["وَّاَنَّا","ظَنَنَّاۤ","اَنْ","لَّنْ","تَقُوْلَ","الْاِنْسُ","وَالْجِنُّ","عَلَی","اللّٰهِ","كَذِبًا"]},{"w":["وَّاَنَّهٗ","كَانَ","رِجَالٌ","مِّنَ","الْاِنْسِ","یَعُوْذُوْنَ","بِرِجَالٍ","مِّنَ","الْجِنِّ","فَزَادُوْهُمْ","رَهَقًا"]},{"w":["وَّاَنَّهُمْ","ظَنُّوْا","كَمَا","ظَنَنْتُمْ","اَنْ","لَّنْ","یَّبْعَثَ","اللّٰهُ","اَحَدًا"]},{"w":["وَّاَنَّا","لَمَسْنَا","السَّمَآءَ","فَوَجَدْنٰهَا","مُلِئَتْ","حَرَسًا","شَدِیْدًا","وَّشُهُبًا"]},{"w":["وَّاَنَّا","كُنَّا","نَقْعُدُ","مِنْهَا","مَقَاعِدَ","لِلسَّمْعِ ؕ","فَمَنْ","یَّسْتَمِعِ","الْاٰنَ","یَجِدْ","لَهٗ","شِهَابًا","رَّصَدًا"]},{"w":["وَّاَنَّا","لَا","نَدْرِیْۤ","اَشَرٌّ","اُرِیْدَ","بِمَنْ","فِی","الْاَرْضِ","اَمْ","اَرَادَ","بِهِمْ","رَبُّهُمْ","رَشَدًا"]},{"w":["وَّاَنَّا","مِنَّا","الصّٰلِحُوْنَ","وَمِنَّا","دُوْنَ","ذٰلِكَ ؕ","كُنَّا","طَرَآىِٕقَ","قِدَدًا"]},{"w":["وَّاَنَّا","ظَنَنَّاۤ","اَنْ","لَّنْ","نُّعْجِزَ","اللّٰهَ","فِی","الْاَرْضِ","وَلَنْ","نُّعْجِزَهٗ","هَرَبًا"]},{"w":["وَّاَنَّا","لَمَّا","سَمِعْنَا","الْهُدٰۤی","اٰمَنَّا","بِهٖ ؕ","فَمَنْ","یُّؤْمِنْ","بِرَبِّهٖ","فَلَا","یَخَافُ","بَخْسًا","وَّلَا","رَهَقًا"]},{"w":["وَّاَنَّا","مِنَّا","الْمُسْلِمُوْنَ","وَمِنَّا","الْقٰسِطُوْنَ ؕ","فَمَنْ","اَسْلَمَ","فَاُولٰٓىِٕكَ","تَحَرَّوْا","رَشَدًا"]},{"w":["وَاَمَّا","الْقٰسِطُوْنَ","فَكَانُوْا","لِجَهَنَّمَ","حَطَبًا"]},{"w":["وَّاَنْ لَّوِ","اسْتَقَامُوْا","عَلَی","الطَّرِیْقَةِ","لَاَسْقَیْنٰهُمْ","مَّآءً","غَدَقًا"]},{"w":["لِّنَفْتِنَهُمْ","فِیْهِ ؕ","وَمَنْ","یُّعْرِضْ","عَنْ","ذِكْرِ","رَبِّهٖ","یَسْلُكْهُ","عَذَابًا","صَعَدًا"]},{"w":["وَّاَنَّ","الْمَسٰجِدَ","لِلّٰهِ","فَلَا","تَدْعُوْا","مَعَ","اللّٰهِ","اَحَدًا"]},{"w":["وَّاَنَّهٗ","لَمَّا","قَامَ","عَبْدُ","اللّٰهِ","یَدْعُوْهُ","كَادُوْا","یَكُوْنُوْنَ","عَلَیْهِ","لِبَدًا"]},{"w":["قُلْ","اِنَّمَاۤ","اَدْعُوْا","رَبِّیْ","وَلَاۤ","اُشْرِكُ","بِهٖۤ","اَحَدًا"]},{"w":["قُلْ","اِنِّیْ","لَاۤ","اَمْلِكُ","لَكُمْ","ضَرًّا","وَّلَا","رَشَدًا"]},{"w":["قُلْ","اِنِّیْ","لَنْ","یُّجِیْرَنِیْ","مِنَ","اللّٰهِ","اَحَدٌ","وَّلَنْ","اَجِدَ","مِنْ","دُوْنِهٖ","مُلْتَحَدًا"]},{"w":["اِلَّا","بَلٰغًا","مِّنَ","اللّٰهِ","وَرِسٰلٰتِهٖ ؕ","وَمَنْ","یَّعْصِ","اللّٰهَ","وَرَسُوْلَهٗ","فَاِنَّ","لَهٗ","نَارَ","جَهَنَّمَ","خٰلِدِیْنَ","فِیْهَاۤ","اَبَدًا"]},{"w":["حَتّٰۤی","اِذَا","رَاَوْا","مَا","یُوْعَدُوْنَ","فَسَیَعْلَمُوْنَ","مَنْ","اَضْعَفُ","نَاصِرًا","وَّاَقَلُّ","عَدَدًا"]},{"w":["قُلْ","اِنْ","اَدْرِیْۤ","اَقَرِیْبٌ","مَّا","تُوْعَدُوْنَ","اَمْ","یَجْعَلُ","لَهٗ","رَبِّیْۤ","اَمَدًا"]},{"w":["عٰلِمُ","الْغَیْبِ","فَلَا","یُظْهِرُ","عَلٰی","غَیْبِهٖۤ","اَحَدًا"]},{"w":["اِلَّا","مَنِ","ارْتَضٰی","مِنْ","رَّسُوْلٍ","فَاِنَّهٗ","یَسْلُكُ","مِنْ","بَیْنِ","یَدَیْهِ","وَمِنْ","خَلْفِهٖ","رَصَدًا"]},{"w":["لِّیَعْلَمَ","اَنْ","قَدْ","اَبْلَغُوْا","رِسٰلٰتِ","رَبِّهِمْ","وَاَحَاطَ","بِمَا","لَدَیْهِمْ","وَاَحْصٰی","كُلَّ","شَیْءٍ","عَدَدًا"]}]}