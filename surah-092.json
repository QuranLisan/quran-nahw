{"surah":92,"ar":"الليل","en":"Al-Layl","ayahs":21,"verses":[{"w":["وَالَّیْلِ","اِذَا","یَغْشٰی"]},{"w":["وَالنَّهَارِ","اِذَا","تَجَلّٰی"]},{"w":["وَمَا","خَلَقَ","الذَّكَرَ","وَالْاُ"]},{"w":["اِنَّ","سَعْیَكُمْ","لَشَتّٰی"]},{"w":["فَاَمَّا","مَنْ","اَعْطٰی","وَاتَّقٰی"]},{"w":["وَصَدَّقَ","بِالْحُسْنٰی"]},{"w":["فَسَنُیَسِّرُهٗ","لِلْیُسْرٰی"]},{"w":["وَاَمَّا","مَنْ","بَخِلَ","وَاسْتَغْنٰی"]},{"w":["وَكَذَّبَ","بِالْحُسْنٰی"]},{"w":["فَسَنُیَسِّرُهٗ","لِلْعُسْرٰی"]},{"w":["وَمَا","یُغْنِیْ","عَنْهُ","مَالُهٗۤ","اِذَا","تَرَدّٰی"]},{"w":["اِنَّ","عَلَیْنَا","لَلْهُدٰی"]},{"w":["وَاِنَّ","لَنَا","لَلْاٰخِرَةَ","وَالْاُوْلٰی"]},{"w":["فَاَنْذَرْتُكُمْ","نَارًا","تَلَظّٰی"]},{"w":["لَا","یَصْلٰىهَاۤ","اِلَّا","الْاَشْقَی"]},{"w":["الَّذِیْ","كَذَّبَ","وَتَوَلّٰی"]},{"w":["وَسَیُجَنَّبُهَا","الْاَتْقَی"]},{"w":["الَّذِیْ","یُؤْتِیْ","مَالَهٗ","یَتَزَكّٰی"]},{"w":["وَمَا","لِاَحَدٍ","عِنْدَهٗ","مِنْ","نِّعْمَةٍ","تُجْزٰۤی"]},{"w":["اِلَّا","ابْتِغَآءَ","وَجْهِ","رَبِّهِ","الْاَعْلٰی"]},{"w":["وَلَسَوْفَ","یَرْضٰی"]}]}