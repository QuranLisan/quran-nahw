{"surah":81,"ar":"التكوير","en":"At-Takwir","ayahs":29,"verses":[{"w":["اِذَا","الشَّمْسُ","كُوِّرَتْ"]},{"w":["وَاِذَا","النُّجُوْمُ","انْكَدَرَتْ"]},{"w":["وَاِذَا","الْجِبَالُ","سُیِّرَتْ"]},{"w":["وَاِذَا","الْعِشَارُ","عُطِّلَتْ"]},{"w":["وَاِذَا","الْوُحُوْشُ","حُشِرَتْ"]},{"w":["وَاِذَا","الْبِحَارُ","سُجِّرَتْ"]},{"w":["وَاِذَا","النُّفُوْسُ","زُوِّجَتْ"]},{"w":["وَاِذَا","الْمَوْءٗدَةُ","سُىِٕلَتْ"]},{"w":["بِاَیِّ","ذَنْۢبٍ","قُتِلَتْ"]},{"w":["وَاِذَا","الصُّحُفُ","نُشِرَتْ"]},{"w":["وَاِذَا","السَّمَآءُ","كُشِطَتْ"]},{"w":["وَاِذَا","الْجَحِیْمُ","سُعِّرَتْ"]},{"w":["وَاِذَا","الْجَنَّةُ","اُزْلِفَتْ"]},{"w":["عَلِمَتْ","نَفْسٌ","مَّاۤ","اَحْضَرَتْ"]},{"w":["فَلَاۤ","اُقْسِمُ","بِالْخُنَّسِ"]},{"w":["الْجَوَارِ","الْكُنَّسِ"]},{"w":["وَالَّیْلِ","اِذَا","عَسْعَسَ"]},{"w":["وَالصُّبْحِ","اِذَا","تَنَفَّسَ"]},{"w":["اِنَّهٗ","لَقَوْلُ","رَسُوْلٍ","كَرِیْمٍ"]},{"w":["ذِیْ","قُوَّةٍ","عِنْدَ","ذِی","الْعَرْشِ","مَكِیْنٍ"]},{"w":["مُّطَاعٍ","ثَمَّ","اَمِیْنٍ"]},{"w":["وَمَا","صَاحِبُكُمْ","بِمَجْنُوْنٍ"]},{"w":["وَلَقَدْ","رَاٰهُ","بِالْاُفُقِ","الْمُبِیْنِ"]},{"w":["وَمَا","هُوَ","عَلَی","الْغَیْبِ","بِضَنِیْنٍ"]},{"w":["وَمَا","هُوَ","بِقَوْلِ","شَیْطٰنٍ","رَّجِیْمٍ"]},{"w":["فَاَیْنَ","تَذْهَبُوْنَ"]},{"w":["اِنْ","هُوَ","اِلَّا","ذِكْرٌ","لِّلْعٰلَمِیْنَ"]},{"w":["لِمَنْ","شَآءَ","مِنْكُمْ","اَنْ","یَّسْتَقِیْمَ"]},{"w":["وَمَا","تَشَآءُوْنَ","اِلَّاۤ","اَنْ","یَّشَآءَ","اللّٰهُ","رَبُّ","الْعٰلَمِیْنَ"]}]}