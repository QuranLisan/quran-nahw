{"surah":26,"ar":"الشعراء","en":"Ash-Shuara","ayahs":227,"verses":[{"w":["طٰسٓمّٓ"]},{"w":["تِلْكَ","اٰیٰتُ","الْكِتٰبِ","الْمُبِیْنِ"]},{"w":["لَعَلَّكَ","بَاخِعٌ","نَّفْسَكَ","اَلَّا","یَكُوْنُوْا","مُؤْمِنِیْنَ"]},{"w":["اِنْ","نَّشَاْ","نُنَزِّلْ","عَلَیْهِمْ","مِّنَ","السَّمَآءِ","اٰیَةً","فَظَلَّتْ","اَعْنَاقُهُمْ","لَهَا","خٰضِعِیْنَ"]},{"w":["وَمَا","یَاْتِیْهِمْ","مِّنْ","ذِكْرٍ","مِّنَ","الرَّحْمٰنِ","مُحْدَثٍ","اِلَّا","كَانُوْا","عَنْهُ","مُعْرِضِیْنَ"]},{"w":["فَقَدْ","كَذَّبُوْا","فَسَیَاْتِیْهِمْ","اَنْۢبٰٓؤُا","مَا","كَانُوْا","بِهٖ","یَسْتَهْزِءُوْنَ"]},{"w":["اَوَلَمْ","یَرَوْا","اِلَی","الْاَرْضِ","كَمْ","اَنْۢبَتْنَا","فِیْهَا","مِنْ","كُلِّ","زَوْجٍ","كَرِیْمٍ"]},{"w":["اِنَّ","فِیْ","ذٰلِكَ","لَاٰیَةً ؕ","وَمَا","كَانَ","اَكْثَرُهُمْ","مُّؤْمِنِیْنَ"]},{"w":["وَاِنَّ","رَبَّكَ","لَهُوَ","الْعَزِیْزُ","الرَّحِیْمُ"]},{"w":["وَاِذْ","نَادٰی","رَبُّكَ","مُوْسٰۤی","اَنِ","ائْتِ","الْقَوْمَ","الظّٰلِمِیْنَ"]},{"w":["قَوْمَ","فِرْعَوْنَ ؕ","اَلَا","یَتَّقُوْنَ"]},{"w":["قَالَ","رَبِّ","اِنِّیْۤ","اَخَافُ","اَنْ","یُّكَذِّبُوْنِ"]},{"w":["وَیَضِیْقُ","صَدْرِیْ","وَلَا","یَنْطَلِقُ","لِسَانِیْ","فَاَرْسِلْ","اِلٰی","هٰرُوْنَ"]},{"w":["وَلَهُمْ","عَلَیَّ","ذَنْۢبٌ","فَاَخَافُ","اَنْ","یَّقْتُلُوْنِ"]},{"w":["قَالَ","كَلَّا","فَاذْهَبَا","بِاٰیٰتِنَاۤ","اِنَّا","مَعَكُمْ","مُّسْتَمِعُوْنَ"]},{"w":["فَاْتِیَا","فِرْعَوْنَ","فَقُوْلَاۤ","اِنَّا","رَسُوْلُ","رَبِّ","الْعٰلَمِیْنَ"]},{"w":["اَنْ","اَرْسِلْ","مَعَنَا","بَنِیْۤ","اِسْرَآءِیْلَ"]},{"w":["قَالَ","اَلَمْ","نُرَبِّكَ","فِیْنَا","وَلِیْدًا","وَّلَبِثْتَ","فِیْنَا","مِنْ","عُمُرِكَ","سِنِیْنَ"]},{"w":["وَفَعَلْتَ","فَعْلَتَكَ","الَّتِیْ","فَعَلْتَ","وَاَنْتَ","مِنَ","الْكٰفِرِیْنَ"]},{"w":["قَالَ","فَعَلْتُهَاۤ","اِذًا","وَّاَنَا","مِنَ","الضَّآلِّیْنَ"]},{"w":["فَفَرَرْتُ","مِنْكُمْ","لَمَّا","خِفْتُكُمْ","فَوَهَبَ","لِیْ","رَبِّیْ","حُكْمًا","وَّجَعَلَنِیْ","مِنَ","الْمُرْسَلِیْنَ"]},{"w":["وَتِلْكَ","نِعْمَةٌ","تَمُنُّهَا","عَلَیَّ","اَنْ","عَبَّدْتَّ","بَنِیْۤ","اِسْرَآءِیْلَ"]},{"w":["قَالَ","فِرْعَوْنُ","وَمَا","رَبُّ","الْعٰلَمِیْنَ"]},{"w":["قَالَ","رَبُّ","السَّمٰوٰتِ","وَالْاَرْضِ","وَمَا","بَیْنَهُمَا ؕ","اِنْ","كُنْتُمْ","مُّوْقِنِیْنَ"]},{"w":["قَالَ","لِمَنْ","حَوْلَهٗۤ","اَلَا","تَسْتَمِعُوْنَ"]},{"w":["قَالَ","رَبُّكُمْ","وَرَبُّ","اٰبَآىِٕكُمُ","الْاَوَّلِیْنَ"]},{"w":["قَالَ","اِنَّ","رَسُوْلَكُمُ","الَّذِیْۤ","اُرْسِلَ","اِلَیْكُمْ","لَمَجْنُوْنٌ"]},{"w":["قَالَ","رَبُّ","الْمَشْرِقِ","وَالْمَغْرِبِ","وَمَا","بَیْنَهُمَا ؕ","اِنْ","كُنْتُمْ","تَعْقِلُوْنَ"]},{"w":["قَالَ","لَىِٕنِ","اتَّخَذْتَ","اِلٰهًا","غَیْرِیْ","لَاَجْعَلَنَّكَ","مِنَ","الْمَسْجُوْنِیْنَ"]},{"w":["قَالَ","اَوَلَوْ","جِئْتُكَ","بِشَیْءٍ","مُّبِیْنٍ"]},{"w":["قَالَ","فَاْتِ","بِهٖۤ","اِنْ","كُنْتَ","مِنَ","الصّٰدِقِیْنَ"]},{"w":["فَاَلْقٰی","عَصَاهُ","فَاِذَا","هِیَ","ثُعْبَانٌ","مُّبِیْنٌ"]},{"w":["وَّنَزَعَ","یَدَهٗ","فَاِذَا","هِیَ","بَیْضَآءُ","لِلنّٰظِرِیْنَ"]},{"w":["قَالَ","لِلْمَلَاِ","حَوْلَهٗۤ","اِنَّ","هٰذَا","لَسٰحِرٌ","عَلِیْمٌ"]},{"w":["یُّرِیْدُ","اَنْ","یُّخْرِجَكُمْ","مِّنْ","اَرْضِكُمْ","بِسِحْرِهٖ","فَمَاذَا","تَاْمُرُوْنَ"]},{"w":["قَالُوْۤا","اَرْجِهْ","وَاَخَاهُ","وَابْعَثْ","فِی","الْمَدَآىِٕنِ","حٰشِرِیْنَ"]},{"w":["یَاْتُوْكَ","بِكُلِّ","سَحَّارٍ","عَلِیْمٍ"]},{"w":["فَجُمِعَ","السَّحَرَةُ","لِمِیْقَاتِ","یَوْمٍ","مَّعْلُوْمٍ"]},{"w":["وَّقِیْلَ","لِلنَّاسِ","هَلْ","اَنْتُمْ","مُّجْتَمِعُوْنَ"]},{"w":["لَعَلَّنَا","نَتَّبِعُ","السَّحَرَةَ","اِنْ","كَانُوْا","هُمُ","الْغٰلِبِیْنَ"]},{"w":["فَلَمَّا","جَآءَ","السَّحَرَةُ","قَالُوْا","لِفِرْعَوْنَ","اَىِٕنَّ","لَنَا","لَاَجْرًا","اِنْ","كُنَّا","نَحْنُ","الْغٰلِبِیْنَ"]},{"w":["قَالَ","نَعَمْ","وَاِنَّكُمْ","اِذًا","لَّمِنَ","الْمُقَرَّبِیْنَ"]},{"w":["قَالَ","لَهُمْ","مُّوْسٰۤی","اَلْقُوْا","مَاۤ","اَنْتُمْ","مُّلْقُوْنَ"]},{"w":["فَاَلْقَوْا","حِبَالَهُمْ","وَعِصِیَّهُمْ","وَقَالُوْا","بِعِزَّةِ","فِرْعَوْنَ","اِنَّا","لَنَحْنُ","الْغٰلِبُوْنَ"]},{"w":["فَاَلْقٰی","مُوْسٰی","عَصَاهُ","فَاِذَا","هِیَ","تَلْقَفُ","مَا","یَاْفِكُوْنَ"]},{"w":["فَاُلْقِیَ","السَّحَرَةُ","سٰجِدِیْنَ"]},{"w":["قَ