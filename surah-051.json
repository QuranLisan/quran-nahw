{"surah":51,"ar":"الذاريات","en":"Adh-Dhariyat","ayahs":60,"verses":[{"w":["وَالذّٰرِیٰتِ","ذَرْوًا"]},{"w":["فَالْحٰمِلٰتِ","وِقْرًا"]},{"w":["فَالْجٰرِیٰتِ","یُسْرًا"]},{"w":["فَالْمُقَسِّمٰتِ","اَمْرًا"]},{"w":["اِنَّمَا","تُوْعَدُوْنَ","لَصَادِقٌ"]},{"w":["وَّاِنَّ","الدِّیْنَ","لَوَاقِعٌ"]},{"w":["وَالسَّمَآءِ","ذَاتِ","الْحُبُكِ"]},{"w":["اِنَّكُمْ","لَفِیْ","قَوْلٍ","مُّخْتَلِفٍ"]},{"w":["یُّؤْفَكُ","عَنْهُ","مَنْ","اُفِكَ"]},{"w":["قُتِلَ","الْخَرّٰصُوْنَ"]},{"w":["الَّذِیْنَ","هُمْ","فِیْ","غَمْرَةٍ","سَاهُوْنَ"]},{"w":["یَسْـَٔلُوْنَ","اَیَّانَ","یَوْمُ","الدِّیْنِ"]},{"w":["یَوْمَ","هُمْ","عَلَی","النَّارِ","یُفْتَنُوْنَ"]},{"w":["ذُوْقُوْا","فِتْنَتَكُمْ ؕ","هٰذَا","الَّذِیْ","كُنْتُمْ","بِهٖ","تَسْتَعْجِلُوْنَ"]},{"w":["اِنَّ","الْمُتَّقِیْنَ","فِیْ","جَنّٰتٍ","وَّعُیُوْنٍ"]},{"w":["اٰخِذِیْنَ","مَاۤ","اٰتٰىهُمْ","رَبُّهُمْ ؕ","اِنَّهُمْ","كَانُوْا","قَبْلَ","ذٰلِكَ","مُحْسِنِیْنَ"]},{"w":["كَانُوْا","قَلِیْلًا","مِّنَ","الَّیْلِ","مَا","یَهْجَعُوْنَ"]},{"w":["وَبِالْاَسْحَارِ","هُمْ","یَسْتَغْفِرُوْنَ"]},{"w":["وَفِیْۤ","اَمْوَالِهِمْ","حَقٌّ","لِّلسَّآىِٕلِ","وَالْمَحْرُوْمِ"]},{"w":["وَفِی","الْاَرْضِ","اٰیٰتٌ","لِّلْمُوْقِنِیْنَ"]},{"w":["وَفِیْۤ","اَنْفُسِكُمْ ؕ","اَفَلَا","تُبْصِرُوْنَ"]},{"w":["وَفِی","السَّمَآءِ","رِزْقُكُمْ","وَمَا","تُوْعَدُوْنَ"]},{"w":["فَوَرَبِّ","السَّمَآءِ","وَالْاَرْضِ","اِنَّهٗ","لَحَقٌّ","مِّثْلَ","مَاۤ","اَنَّكُمْ","تَنْطِقُوْنَ"]},{"w":["هَلْ","اَتٰىكَ","حَدِیْثُ","ضَیْفِ","اِبْرٰهِیْمَ","الْمُكْرَمِیْنَ"]},{"w":["اِذْ","دَخَلُوْا","عَلَیْهِ","فَقَالُوْا","سَلٰمًا ؕ","قَالَ","سَلٰمٌ","قَوْمٌ","مُّنْكَرُوْنَ"]},{"w":["فَرَاغَ","اِلٰۤی","اَهْلِهٖ","فَجَآءَ","بِعِجْلٍ","سَمِیْنٍ"]},{"w":["فَقَرَّبَهٗۤ","اِلَیْهِمْ","قَالَ","اَلَا","تَاْكُلُوْنَ"]},{"w":["فَاَوْجَسَ","مِنْهُمْ","خِیْفَةً ؕ","قَالُوْا","لَا","تَخَفْ ؕ","وَبَشَّرُوْهُ","بِغُلٰمٍ","عَلِیْمٍ"]},{"w":["فَاَقْبَلَتِ","امْرَاَتُهٗ","فِیْ","صَرَّةٍ","فَصَكَّتْ","وَجْهَهَا","وَقَالَتْ","عَجُوْزٌ","عَقِیْمٌ"]},{"w":["قَالُوْا","كَذٰلِكِ","قَالَ","رَبُّكِ ؕ","اِنَّهٗ","هُوَ","الْحَكِیْمُ","الْعَلِیْمُ"]},{"w":["قَالَ","فَمَا","خَطْبُكُمْ","اَیُّهَا","الْمُرْسَلُوْنَ"]},{"w":["قَالُوْۤا","اِنَّاۤ","اُرْسِلْنَاۤ","اِلٰی","قَوْمٍ","مُّجْرِمِیْنَ"]},{"w":["لِنُرْسِلَ","عَلَیْهِمْ","حِجَارَةً","مِّنْ","طِیْنٍ"]},{"w":["مُّسَوَّمَةً","عِنْدَ","رَبِّكَ","لِلْمُسْرِفِیْنَ"]},{"w":["فَاَخْرَجْنَا","مَنْ","كَانَ","فِیْهَا","مِنَ","الْمُؤْمِنِیْنَ"]},{"w":["فَمَا","وَجَدْنَا","فِیْهَا","غَیْرَ","بَیْتٍ","مِّنَ","الْمُسْلِمِیْنَ"]},{"w":["وَتَرَكْنَا","فِیْهَاۤ","اٰیَةً","لِّلَّذِیْنَ","یَخَافُوْنَ","الْعَذَابَ","الْاَلِیْمَ"]},{"w":["وَفِیْ","مُوْسٰۤی","اِذْ","اَرْسَلْنٰهُ","اِلٰی","فِرْعَوْنَ","بِسُلْطٰنٍ","مُّبِیْنٍ"]},{"w":["فَتَوَلّٰی","بِرُكْنِهٖ","وَقَالَ","سٰحِرٌ","اَوْ","مَجْنُوْنٌ"]},{"w":["فَاَخَذْنٰهُ","وَجُنُوْدَهٗ","فَنَبَذْنٰهُمْ","فِی","الْیَمِّ","وَهُوَ","مُلِیْمٌ"]},{"w":["وَفِیْ","عَادٍ","اِذْ","اَرْسَلْنَا","عَلَیْهِمُ","الرِّیْحَ","الْعَقِیْمَ"]},{"w":["مَا","تَذَرُ","مِنْ","شَیْءٍ","اَتَتْ","عَلَیْهِ","اِلَّا","جَعَلَتْهُ","كَالرَّمِیْمِ"]},{"w":["وَفِیْ","ثَمُوْدَ","اِذْ","قِیْلَ","لَهُمْ","تَمَتَّعُوْا","حَتّٰی","حِیْنٍ"]},{"w":["فَعَتَوْا","عَنْ","اَمْرِ","رَبِّهِمْ","فَاَخَذَتْهُمُ","الصّٰعِقَةُ","وَهُمْ","یَنْظُرُوْنَ"]},{"w":["فَمَا","اسْتَطَاعُوْا","مِنْ","قِیَامٍ","وَّمَا","كَانُوْا","مُنْتَصِرِیْنَ"]},{"w":["وَقَوْمَ","نُوْحٍ","مِّنْ","قَبْلُ ؕ","اِنَّهُمْ","كَانُوْا","قَوْمًا","فٰسِقِیْنَ"]},{"w":["وَالسَّمَآءَ","بَنَیْنٰهَا","بِاَیْىدٍ","وَّاِنَّا","لَمُوْسِعُوْنَ"]},{"w":["وَالْاَرْضَ","فَرَشْنٰهَا","فَنِعْمَ","الْمٰهِدُوْنَ"]},{"w":["وَمِنْ","كُلِّ","شَیْءٍ","خَلَقْنَا","زَوْجَیْنِ","لَعَلَّكُمْ","تَذَكَّرُوْنَ"]},{"w":["فَفِرُّوْۤا","اِلَی","اللّٰهِ ؕ","اِنِّیْ","لَكُمْ","مِّنْهُ","نَذِیْرٌ","مُّبِیْنٌ"]},{"w":["وَلَا","تَجْعَلُوْا","مَعَ","اللّٰهِ","اِلٰهًا","اٰخَرَ ؕ","اِنِّیْ","لَكُمْ","مِّنْهُ","نَذِیْرٌ","مُّبِیْنٌ"]},{"w":["كَذٰلِكَ","مَاۤ","اَتَی","الَّذِیْنَ","مِنْ","قَبْلِهِمْ","مِّنْ","رَّسُوْلٍ","اِلَّا","قَالُوْا","سَاحِرٌ","اَوْ","مَجْنُوْنٌ"]},{"w":["اَتَوَاصَوْا","بِهٖ","بَلْ","هُمْ","قَوْمٌ","طَاغُوْنَ"]},{"w":["فَتَوَلَّ","عَنْهُمْ","فَمَاۤ","اَنْتَ","بِمَلُوْمٍ"]},{"w":["وَّذَكِّرْ","فَاِنَّ","الذِّكْرٰی","تَنْفَعُ","الْمُؤْمِنِیْنَ"]},{"w":["وَمَا","خَلَقْتُ","الْجِنَّ","وَالْاِنْسَ","اِلَّا","لِیَعْبُدُوْنِ"]},{"w":["مَاۤ","اُرِیْدُ","مِنْهُمْ","مِّنْ","رِّزْقٍ","وَّمَاۤ","اُرِیْدُ","اَنْ","یُّطْعِمُوْنِ"]},{"w":["اِنَّ","اللّٰهَ","هُوَ","الرَّزَّاقُ","ذُو","الْقُوَّةِ","الْمَتِیْنُ"]},{"w":["فَاِنَّ","لِلَّذِیْنَ","ظَلَمُوْا","ذَنُوْبًا","مِّثْلَ","ذَنُوْبِ","اَصْحٰبِهِمْ","فَلَا","یَسْتَعْجِلُوْنِ"]},{"w":["فَوَیْلٌ","لِّلَّذِیْنَ","كَفَرُوْا","مِنْ","یَّوْمِهِمُ","الَّذِیْ","یُوْعَدُوْنَ"]}]}