{"surah":23,"ar":"المؤمنون","en":"Al-Muminun","ayahs":118,"verses":[{"w":["قَدْ","اَفْلَحَ","الْمُؤْمِنُوْنَ"]},{"w":["الَّذِیْنَ","هُمْ","فِیْ","صَلَاتِهِمْ","خٰشِعُوْنَ"]},{"w":["وَالَّذِیْنَ","هُمْ","عَنِ","اللَّغْوِ","مُعْرِضُوْنَ"]},{"w":["وَالَّذِیْنَ","هُمْ","لِلزَّكٰوةِ","فٰعِلُوْنَ"]},{"w":["وَالَّذِیْنَ","هُمْ","لِفُرُوْجِهِمْ","حٰفِظُوْنَ"]},{"w":["اِلَّا","عَلٰۤی","اَزْوَاجِهِمْ","اَوْ","مَا","مَلَكَتْ","اَیْمَانُهُمْ","فَاِنَّهُمْ","غَیْرُ","مَلُوْمِیْنَ"]},{"w":["فَمَنِ","ابْتَغٰی","وَرَآءَ","ذٰلِكَ","فَاُولٰٓىِٕكَ","هُمُ","الْعٰدُوْنَ"]},{"w":["وَالَّذِیْنَ","هُمْ","لِاَمٰنٰتِهِمْ","وَعَهْدِهِمْ","رٰعُوْنَ"]},{"w":["وَالَّذِیْنَ","هُمْ","عَلٰی","صَلَوٰتِهِمْ","یُحَافِظُوْنَ"]},{"w":["اُولٰٓىِٕكَ","هُمُ","الْوٰرِثُوْنَ"]},{"w":["الَّذِیْنَ","یَرِثُوْنَ","الْفِرْدَوْسَ ؕ","هُمْ","فِیْهَا","خٰلِدُوْنَ"]},{"w":["وَلَقَدْ","خَلَقْنَا","الْاِنْسَانَ","مِنْ","سُلٰلَةٍ","مِّنْ","طِیْنٍ"]},{"w":["ثُمَّ","جَعَلْنٰهُ","نُطْفَةً","فِیْ","قَرَارٍ","مَّكِیْنٍ"]},{"w":["ثُمَّ","خَلَقْنَا","النُّطْفَةَ","عَلَقَةً","فَخَلَقْنَا","الْعَلَقَةَ","مُضْغَةً","فَخَلَقْنَا","الْمُضْغَةَ","عِظٰمًا","فَكَسَوْنَا","الْعِظٰمَ","لَحْمًا","ثُمَّ","اَنْشَاْنٰهُ","خَلْقًا","اٰخَرَ ؕ","فَتَبٰرَكَ","اللّٰهُ","اَحْسَنُ","الْخٰلِقِیْنَ"]},{"w":["ثُمَّ","اِنَّكُمْ","بَعْدَ","ذٰلِكَ","لَمَیِّتُوْنَ"]},{"w":["ثُمَّ","اِنَّكُمْ","یَوْمَ","الْقِیٰمَةِ","تُبْعَثُوْنَ"]},{"w":["وَلَقَدْ","خَلَقْنَا","فَوْقَكُمْ","سَبْعَ","طَرَآىِٕقَ","وَمَا","كُنَّا","عَنِ","الْخَلْقِ","غٰفِلِیْنَ"]},{"w":["وَاَنْزَلْنَا","مِنَ","السَّمَآءِ","مَآءً","بِقَدَرٍ","فَاَسْكَنّٰهُ","فِی","الْاَرْضِ","وَاِنَّا","عَلٰی","ذَهَابٍ","بِهٖ","لَقٰدِرُوْنَ"]},{"w":["فَاَنْشَاْنَا","لَكُمْ","بِهٖ","جَنّٰتٍ","مِّنْ","نَّخِیْلٍ","وَّاَعْنَابٍ ","لَكُمْ","فِیْهَا","فَوَاكِهُ","كَثِیْرَةٌ","وَّمِنْهَا","تَاْكُلُوْنَ"]},{"w":["وَشَجَرَةً","تَخْرُجُ","مِنْ","طُوْرِ","سَیْنَآءَ","تَنْۢبُتُ","بِالدُّهْنِ","وَصِبْغٍ","لِّلْاٰكِلِیْنَ"]},{"w":["وَاِنَّ","لَكُمْ","فِی","الْاَنْعَامِ","لَعِبْرَةً ؕ","نُسْقِیْكُمْ","مِّمَّا","فِیْ","بُطُوْنِهَا","وَلَكُمْ","فِیْهَا","مَنَافِعُ","كَثِیْرَةٌ","وَّمِنْهَا","تَاْكُلُوْنَ"]},{"w":["وَعَلَیْهَا","وَعَلَی","الْفُلْكِ","تُحْمَلُوْنَ"]},{"w":["وَلَقَدْ","اَرْسَلْنَا","نُوْحًا","اِلٰی","قَوْمِهٖ","فَقَالَ","یٰقَوْمِ","اعْبُدُوا","اللّٰهَ","مَا","لَكُمْ","مِّنْ","اِلٰهٍ","غَیْرُهٗ ؕ","اَفَلَا","تَتَّقُوْنَ"]},{"w":["فَقَالَ","الْمَلَؤُا","الَّذِیْنَ","كَفَرُوْا","مِنْ","قَوْمِهٖ","مَا","هٰذَاۤ","اِلَّا","بَشَرٌ","مِّثْلُكُمْ","یُرِیْدُ","اَنْ","یَّتَفَضَّلَ","عَلَیْكُمْ ؕ","وَلَوْ","شَآءَ","اللّٰهُ","لَاَنْزَلَ","مَلٰٓىِٕكَةً","مَّا","سَمِعْنَا","بِهٰذَا","فِیْۤ","اٰبَآىِٕنَا","الْاَوَّلِیْنَ"]},{"w":["اِنْ","هُوَ","اِلَّا","رَجُلٌۢ","بِهٖ","جِنَّةٌ","فَتَرَبَّصُوْا","بِهٖ","حَتّٰی","حِیْنٍ"]},{"w":["قَالَ","رَبِّ","انْصُرْنِیْ","بِمَا","كَذَّبُوْنِ"]},{"w":["فَاَوْحَیْنَاۤ","اِلَیْهِ","اَنِ","اصْنَعِ","الْفُلْكَ","بِاَعْیُنِنَا","وَوَحْیِنَا","فَاِذَا","جَآءَ","اَمْرُنَا","وَفَارَ","التَّنُّوْرُ","فَاسْلُكْ","فِیْهَا","مِنْ","كُلٍّ","زَوْجَیْنِ","اثْنَیْنِ","وَاَهْلَكَ","اِلَّا","مَنْ","سَبَقَ","عَلَیْهِ","الْقَوْلُ","مِنْهُمْ","وَلَا","تُخَاطِبْنِیْ","فِی","الَّذِیْنَ","ظَلَمُوْا","اِنَّهُمْ","مُّغْرَقُوْنَ"]},{"w":["فَاِذَا","اسْتَوَیْتَ","اَنْتَ","وَمَنْ","مَّعَكَ","عَلَی","الْفُلْكِ","فَقُلِ","الْحَمْدُ","لِلّٰهِ","الَّذِیْ","نَجّٰىنَا","مِنَ","الْقَوْمِ","الظّٰلِمِیْنَ"]},{"w":["وَقُلْ","رَّبِّ","اَنْزِلْنِیْ","مُنْزَلًا","مُّبٰرَكًا","وَّاَنْتَ","خَیْرُ","الْمُنْزِلِیْنَ"]},{"w":["اِنَّ","فِیْ","ذٰلِكَ","لَاٰیٰتٍ","وَّاِنْ","كُنَّا","لَمُبْتَلِیْنَ"]},{"w":["ثُمَّ","اَنْشَاْنَا","مِنْ","بَعْدِهِمْ","قَرْنًا","اٰخَرِیْنَ"]},{"w":["فَاَرْسَلْنَا","فِیْهِمْ","رَسُوْلًا","مِّنْهُمْ","اَنِ","اعْبُدُوا","اللّٰهَ","مَا","لَكُمْ","مِّنْ","اِلٰهٍ","غَیْرُهٗ ؕ","اَفَلَا","تَتَّقُوْنَ"]},{"w":["وَقَالَ","الْمَلَاُ","مِنْ","قَوْمِهِ","الَّذِیْنَ","كَفَرُوْا","وَكَذَّبُوْا","بِلِقَآءِ","الْاٰخِرَةِ","وَاَتْرَفْنٰهُمْ","فِی","الْحَیٰوةِ","الدُّنْیَا","مَا","هٰذَاۤ","اِلَّا","بَشَرٌ","مِّثْلُكُمْ","یَاْكُلُ","مِمَّا","تَاْكُلُوْنَ","مِنْهُ","وَیَشْرَب