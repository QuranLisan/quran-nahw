{"surah":19,"ar":"مريم","en":"Maryam","ayahs":98,"verses":[{"w":["كٓهٰیٰعٓصٓ"]},{"w":["ذِكْرُ","رَحْمَتِ","رَبِّكَ","عَبْدَهٗ","زَكَرِیَّا"]},{"w":["اِذْ","نَادٰی","رَبَّهٗ","نِدَآءً","خَفِیًّا"]},{"w":["قَالَ","رَبِّ","اِنِّیْ","وَهَنَ","الْعَظْمُ","مِنِّیْ","وَاشْتَعَلَ","الرَّاْسُ","شَیْبًا","وَّلَمْ","اَكُنْ","بِدُعَآىِٕكَ","رَبِّ","شَقِیًّا"]},{"w":["وَاِنِّیْ","خِفْتُ","الْمَوَالِیَ","مِنْ","وَّرَآءِیْ","وَكَانَتِ","امْرَاَتِیْ","عَاقِرًا","فَهَبْ","لِیْ","مِنْ","لَّدُنْكَ","وَلِیًّا"]},{"w":["یَّرِثُنِیْ","وَیَرِثُ","مِنْ","اٰلِ","یَعْقُوْبَ","وَاجْعَلْهُ","رَبِّ","رَضِیًّا"]},{"w":["یٰزَكَرِیَّاۤ","اِنَّا","نُبَشِّرُكَ","بِغُلٰمِ","سْمُهٗ","یَحْیٰی","لَمْ","نَجْعَلْ","لَّهٗ","مِنْ","قَبْلُ","سَمِیًّا"]},{"w":["قَالَ","رَبِّ","اَنّٰی","یَكُوْنُ","لِیْ","غُلٰمٌ","وَّكَانَتِ","امْرَاَتِیْ","عَاقِرًا","وَّقَدْ","بَلَغْتُ","مِنَ","الْكِبَرِ","عِتِیًّا"]},{"w":["قَالَ","كَذٰلِكَ","قَالَ","رَبُّكَ","هُوَ","عَلَیَّ","هَیِّنٌ","وَّقَدْ","خَلَقْتُكَ","مِنْ","قَبْلُ","وَلَمْ","تَكُ","شَیْـًٔا"]},{"w":["قَالَ","رَبِّ","اجْعَلْ","لِّیْۤ","اٰیَةً ؕ","قَالَ","اٰیَتُكَ","اَلَّا","تُكَلِّمَ","النَّاسَ","ثَلٰثَ","لَیَالٍ","سَوِیًّا"]},{"w":["فَخَرَجَ","عَلٰی","قَوْمِهٖ","مِنَ","الْمِحْرَابِ","فَاَوْحٰۤی","اِلَیْهِمْ","اَنْ","سَبِّحُوْا","بُكْرَةً","وَّعَشِیًّا"]},{"w":["یٰیَحْیٰی","خُذِ","الْكِتٰبَ","بِقُوَّةٍ ؕ","وَاٰتَیْنٰهُ","الْحُكْمَ","صَبِیًّا"]},{"w":["وَّحَنَانًا","مِّنْ","لَّدُنَّا","وَزَكٰوةً ؕ","وَكَانَ","تَقِیًّا"]},{"w":["وَّبَرًّا","بِوَالِدَیْهِ","وَلَمْ","یَكُنْ","جَبَّارًا","عَصِیًّا"]},{"w":["وَسَلٰمٌ","عَلَیْهِ","یَوْمَ","وُلِدَ","وَیَوْمَ","یَمُوْتُ","وَیَوْمَ","یُبْعَثُ","حَیًّا"]},{"w":["وَاذْكُرْ","فِی","الْكِتٰبِ","مَرْیَمَ ","اِذِ","انْتَبَذَتْ","مِنْ","اَهْلِهَا","مَكَانًا","شَرْقِیًّا"]},{"w":["فَاتَّخَذَتْ","مِنْ","دُوْنِهِمْ","حِجَابًا","فَاَرْسَلْنَاۤ","اِلَیْهَا","رُوْحَنَا","فَتَمَثَّلَ","لَهَا","بَشَرًا","سَوِیًّا"]},{"w":["قَالَتْ","اِنِّیْۤ","اَعُوْذُ","بِالرَّحْمٰنِ","مِنْكَ","اِنْ","كُنْتَ","تَقِیًّا"]},{"w":["قَالَ","اِنَّمَاۤ","اَنَا","رَسُوْلُ","رَبِّكِ","لِاَهَبَ","لَكِ","غُلٰمًا","زَكِیًّا"]},{"w":["قَالَتْ","اَنّٰی","یَكُوْنُ","لِیْ","غُلٰمٌ","وَّلَمْ","یَمْسَسْنِیْ","بَشَرٌ","وَّلَمْ","اَكُ","بَغِیًّا"]},{"w":["قَالَ","كَذٰلِكِ","قَالَ","رَبُّكِ","هُوَ","عَلَیَّ","هَیِّنٌ","وَلِنَجْعَلَهٗۤ","اٰیَةً","لِّلنَّاسِ","وَرَحْمَةً","مِّنَّا","وَكَانَ","اَمْرًا","مَّقْضِیًّا"]},{"w":["فَحَمَلَتْهُ","فَانْتَبَذَتْ","بِهٖ","مَكَانًا","قَصِیًّا"]},{"w":["فَاَجَآءَهَا","الْمَخَاضُ","اِلٰی","جِذْعِ","النَّخْلَةِ","قَالَتْ","یٰلَیْتَنِیْ","مِتُّ","قَبْلَ","هٰذَا","وَكُنْتُ","نَسْیًا","مَّنْسِیًّا"]},{"w":["فَنَادٰىهَا","مِنْ","تَحْتِهَاۤ","اَلَّا","تَحْزَنِیْ","قَدْ","جَعَلَ","رَبُّكِ","تَحْتَكِ","سَرِیًّا"]},{"w":["وَهُزِّیْۤ","اِلَیْكِ","بِجِذْعِ","النَّخْلَةِ","تُسٰقِطْ","عَلَیْكِ","رُطَبًا","جَنِیًّا"]},{"w":["فَكُلِیْ","وَاشْرَبِیْ","وَقَرِّیْ","عَیْنًا","فَاِمَّا","تَرَیِنَّ","مِنَ","الْبَشَرِ","اَحَدًا","فَقُوْلِیْۤ","اِنِّیْ","نَذَرْتُ","لِلرَّحْمٰنِ","صَوْمًا","فَلَنْ","اُكَلِّمَ","الْیَوْمَ","اِنْسِیًّا"]},{"w":["فَاَتَتْ","بِهٖ","قَوْمَهَا","تَحْمِلُهٗ ؕ","قَالُوْا","یٰمَرْیَمُ","لَقَدْ","جِئْتِ","شَیْـًٔا","فَرِیًّا"]},{"w":["یٰۤاُخْتَ","هٰرُوْنَ","مَا","كَانَ","اَبُوْكِ","امْرَاَ","سَوْءٍ","وَّمَا","كَانَتْ","اُمُّكِ","بَغِیًّا"]},{"w":["فَاَشَارَتْ","اِلَیْهِ ؕ","قَالُوْا","كَیْفَ","نُكَلِّمُ","مَنْ","كَانَ","فِی","الْمَهْدِ","صَبِیًّا"]},{"w":["قَالَ","اِنِّیْ","عَبْدُ","اللّٰهِ ؕ","اٰتٰىنِیَ","الْكِتٰبَ","وَجَعَلَنِیْ","نَبِیًّا"]},{"w":["وَّجَعَلَنِیْ","مُبٰرَكًا","اَیْنَ","مَا","كُنْتُ","وَاَوْصٰنِیْ","بِالصَّلٰوةِ","وَالزَّكٰوةِ","مَا","دُمْتُ","حَیًّا"]},{"w":["وَّبَرًّا","بِوَالِدَتِیْ ؗ","وَلَمْ","یَجْعَلْنِیْ","جَبَّارًا","شَقِیًّا"]},{"w":["وَالسَّلٰمُ","عَلَیَّ","یَوْمَ","وُلِدْتُّ","وَیَوْمَ","اَمُوْتُ","وَیَوْمَ","اُبْعَثُ","حَیًّا"]},{"w":["ذٰلِكَ","عِیْسَی","ابْنُ","مَرْیَمَ","قَوْلَ","الْحَقِّ","الَّذِیْ","فِیْهِ","یَمْتَرُوْنَ"]},{"w":["مَا","كَانَ","لِلّٰهِ","اَنْ","یَّتَّخِذَ","مِنْ","وَّلَدٍ","سُبْحٰنَهٗ ؕ","اِذَا","قَضٰۤی","اَمْرًا","فَاِنَّمَا","یَقُوْلُ","لَهٗ",